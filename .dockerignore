# The root context is used by the webapp's cross-package build.
**
!sortsys-api-v2/
sortsys-api-v2/**
!sortsys-api-v2/client/
!sortsys-api-v2/client/**
!sortsys-dwgviewer/
!sortsys-dwgviewer/**
!sortsys-react-components/
!sortsys-react-components/**
!sortsys-webapp-v2/
!sortsys-webapp-v2/**

# Keep local credentials, dependencies and build artifacts out of every stage.
**/.git
**/.env
**/.env.*
**/.compose-env
**/.compose-env.*
**/.npmrc
**/.ssh
**/*.key
**/*.p12
**/*.pfx
**/node_modules
**/target
**/build
**/dist
**/out
**/.react-router
**/.cache
**/.turbo
**/coverage
**/playwright-report
**/test-results
**/*.log
**/*.tsbuildinfo
**/.DS_Store
