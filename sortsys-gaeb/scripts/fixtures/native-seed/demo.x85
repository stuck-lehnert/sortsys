<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA85/3.3"><GAEBInfo><Version>3.3</Version><VersDate>2021-05</VersDate><Date>2026-11-06</Date><ProgSystem>sortsys</ProgSystem><ProgName>sortsys Demo</ProgName></GAEBInfo><Award><DP>85</DP><AwardInfo><Cur>EUR</Cur></AwardInfo><CTR><Address><Name1>Malerbetrieb Beispiel GmbH</Name1><Street>Beispielweg 12</Street><PCode>06108</PCode><City>Halle (Saale)</City><Country>Deutschland</Country></Address><CntryType>EEA</CntryType></CTR><BoQ ID="boq"><BoQInfo><Name>Musterauftrag</Name><LblBoQ>Musterauftrag</LblBoQ><OutlCompl>AllTxt</OutlCompl><BoQBkdn><Type>BoQLevel</Type><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn><Totals><Total>48626.73</Total></Totals></BoQInfo><BoQBody><BoQCtgy ID="section_1" RNoPart="01"><LblTx><p><span style="font-weight:bold">Ausbau und Oberflächen</span></p></LblTx><BoQBody><Itemlist><Item ID="position_1_0" RNoPart="1"><Qty>180.676</Qty><QU>m²</QU><UP>72.717</UP><IT>13138.22</IT><Description><CompleteText><DetailTxt><Text><p><span>Untergrund reinigen und grundieren. Innenflächen zweimal mit matter Dispersionsfarbe beschichten. Angrenzende Bauteile schützen.</span></p><p><span>Ausführung in Bauabschnitt 3. Die Angaben dieser Beispieldatei sind frei erfunden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span style="font-weight:bold">Innenwandanstrich, zweifach - Bereich 2</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="position_1_1" RNoPart="2"><Qty>68.135</Qty><QU>m</QU><UP>34.544</UP><IT>2353.66</IT><Description><CompleteText><DetailTxt><Text><p><span>Leibungsflächen vorbereiten. Anschlussprofile liefern, einarbeiten und die Oberfläche für den Anstrich glätten.</span></p><p><span>Ausführung in Bauabschnitt 1. Die Angaben dieser Beispieldatei sind frei erfunden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span style="font-weight:bold">Leibungen und Fensteranschlüsse - Bereich 4</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="position_1_2" RNoPart="3"><Qty>10.431</Qty><QU>m³</QU><UP>32.558</UP><IT>339.61</IT><Description><CompleteText><DetailTxt><Text><p><span>Aussparungen und Fehlstellen vorbereiten, mit geeignetem Ausgleichsmörtel schließen und die Oberfläche bündig nacharbeiten.</span></p><p><span>Ausführung in Bauabschnitt 1. Die Angaben dieser Beispieldatei sind frei erfunden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span style="font-weight:bold">Ausgleichsmörtel in Aussparungen - Bereich 3</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="position_1_3" RNoPart="4"><Qty>28.000</Qty><QU>Stk</QU><UP>57.024</UP><IT>1596.67</IT><Description><CompleteText><DetailTxt><Text><p><span>Alte Beschichtung anschleifen, Flächen reinigen und grundieren. Zarge zweimal im abgestimmten Farbton lackieren.</span></p><p><span>Ausführung in Bauabschnitt 1. Die Angaben dieser Beispieldatei sind frei erfunden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span style="font-weight:bold">Türzarge lackieren - Bereich 6</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="position_1_4" RNoPart="5"><Qty>1.000</Qty><QU>psch</QU><UP>39.896</UP><IT>39.90</IT><Description><CompleteText><DetailTxt><Text><p><span>Arbeitsbereiche und Verkehrsflächen von arbeitsbedingten Verschmutzungen reinigen. Verpackungen und Schutzmaterial getrennt aufnehmen.</span></p><p><span>Ausführung in Bauabschnitt 2. Die Angaben dieser Beispieldatei sind frei erfunden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span style="font-weight:bold">Baustellenreinigung - Bereich 4</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="position_1_5" RNoPart="6"><Qty>107.931</Qty><QU>m²</QU><UP>75.415</UP><IT>8139.62</IT><Description><CompleteText><DetailTxt><Text><p><span>Fehlstellen schließen und Übergänge nacharbeiten. Fläche vollflächig spachteln, schleifen und für die Folgebeschichtung vorbereiten.</span></p><p><span>Ausführung in Bauabschnitt 3. Die Angaben dieser Beispieldatei sind frei erfunden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span style="font-weight:bold">Spachtelung von Wandflächen Q3 - Bereich 5</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="position_1_6" RNoPart="7"><Qty>197.885</Qty><QU>m²</QU><UP>22.375</UP><IT>4427.68</IT><Description><CompleteText><DetailTxt><Text><p><span>Böden und Einbauten mit Schutzvlies und Folie abdecken. Schutz während der Arbeiten erhalten und nach Abschluss entfernen.</span></p><p><span>Ausführung in Bauabschnitt 2. Die Angaben dieser Beispieldatei sind frei erfunden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span style="font-weight:bold">Abdecken und Schutzmaßnahmen - Bereich 2</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="position_1_7" RNoPart="8"><Qty>162.931</Qty><QU>m²</QU><UP>10.066</UP><IT>1640.06</IT><Description><CompleteText><DetailTxt><Text><p><span>Unterkonstruktion montieren und mit Gipskarton beplanken. Fugen und Befestigungspunkte nach der vereinbarten Qualitätsstufe verspachteln.</span></p><p><span>Ausführung in Bauabschnitt 4. Die Angaben dieser Beispieldatei sind frei erfunden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span style="font-weight:bold">Trockenbau-Vorsatzschale - Bereich 1</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="position_1_8" RNoPart="9"><Qty>131.094</Qty><QU>m²</QU><UP>54.080</UP><IT>7089.56</IT><Description><CompleteText><DetailTxt><Text><p><span>Unterkonstruktion montieren und mit Gipskarton beplanken. Fugen und Befestigungspunkte nach der vereinbarten Qualitätsstufe verspachteln.</span></p><p><spa