#!/usr/bin/env bash
set -euo pipefail

export NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=4096}"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "Checking coordinated runtime versions"
node ./scripts/check-runtime-versions.mjs
node --test ./scripts/check-runtime-versions.test.mjs

echo "Checking branch promotion and API test orchestration"
node --test ./scripts/deploy-upgrade.test.mjs ./scripts/test-api-upgrade.test.mjs \
  ./scripts/reuse-ci-success.test.mjs

echo
echo "Checking Docker contexts and Compose configurations"
./scripts/test-container-contexts
docker compose --env-file .compose-env.example -f compose.yaml config --quiet
docker compose --env-file .compose-env.example -f ghcr-compose.yaml config --quiet

echo "Checking container hardening, office deployment and JWT configuration"
bun test ./scripts/container-hardening.test.mjs ./scripts/office-deployment.test.mjs

echo
echo "Checking development startup, storage and LLM environment loading"
node --test \
  ./scripts/dev-startup.test.mjs \
  ./scripts/dev-images.test.mjs \
  ./scripts/dev-office-init.test.mjs \
  ./scripts/dev-office-start.test.mjs
bun test ./scripts/dev-storage.test.mjs ./scripts/dev-llm.test.mjs

echo

echo "Running API integration and contract checks"
./scripts/test-api

echo
echo "Running Go job-runner tests"
(
  cd sortsys-v2-job_runner
  go test -mod=readonly ./...
  go vet -mod=readonly ./...
)

echo
echo "Running DWG parser checks"
cargo fmt --manifest-path sortsys-dwgviewer/lib/Cargo.toml -- --check
cargo test --manifest-path sortsys-dwgviewer/lib/Cargo.toml --locked
cargo clippy --manifest-path sortsys-dwgviewer/lib/Cargo.toml --all-targets -- -D warnings

echo
echo "Running DWG viewer checks"
(
  cd sortsys-dwgviewer
  npm ci
  npm run typecheck
  npm test
  npm run test:wasm:rust
)

echo
echo "Checking the shared component implementation"
(
  cd sortsys-react-components
  bun install --frozen-lockfile
  bun run typecheck
)

echo "Checking the standalone GAEB editor suite"
(
  cd sortsys-gaeb
  bun install --frozen-lockfile
  bun run typecheck
  bun test
  bun run build
)

echo
echo "Running webapp checks"
(
  cd sortsys-webapp-v2
  bun install --frozen-lockfile
  bun run licenses:check
  bun run typecheck
  bun run test:local-package-locks
  bun run test:i18n
  bun run test:visit-labels
  bun run test:activity
  bun run test:report-forms
  bun run test:chat-requests
  bun run test:deployment-planning
  bun run test:table
  bun run test:menus
  bun run test:editors
  bun run test:chat-files
  bun run test:attachments
  bun run test:attachment-selection
  bun run test:error-boundary
  bun run test:security-deps
  bun run test:pdf
  bun run test:regie-list
  bun run test:invoice-numbering
  bun run build

  if [ "${CI:-}" = "true" ]; then
    bunx playwright install --with-deps chromium
  else
    bunx playwright install chromium
  fi

  SORTSYS_UI_ASSETS="$PWD/build/client" bun run test:ui
  (cd ../sortsys-gaeb && bun run test:browser)
)
