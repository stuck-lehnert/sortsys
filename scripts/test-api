#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

API_DIR="$ROOT_DIR/sortsys-api-v2"
JOB_RUNNER_DIR="$ROOT_DIR/sortsys-v2-job_runner"

TEST_RUN_SUFFIX="${TEST_RUN_SUFFIX:-$(date +%s)-$RANDOM}"

TEST_NETWORK="${TEST_NETWORK:-sortsys-test-api-network-${TEST_RUN_SUFFIX}}"
TEST_PG_CONTAINER="${TEST_PG_CONTAINER:-sortsys-test-api-postgres-${TEST_RUN_SUFFIX}}"
TEST_S3_CONTAINER="${TEST_S3_CONTAINER:-sortsys-test-api-s3-${TEST_RUN_SUFFIX}}"
TEST_API_CONTAINER="${TEST_API_CONTAINER:-sortsys-test-api-api-${TEST_RUN_SUFFIX}}"
TEST_JOB_RUNNER_1_CONTAINER="${TEST_JOB_RUNNER_1_CONTAINER:-sortsys-test-api-job-runner-1-${TEST_RUN_SUFFIX}}"
TEST_JOB_RUNNER_2_CONTAINER="${TEST_JOB_RUNNER_2_CONTAINER:-sortsys-test-api-job-runner-2-${TEST_RUN_SUFFIX}}"
TEST_JOB_RUNNER_CONTAINERS=("$TEST_JOB_RUNNER_1_CONTAINER" "$TEST_JOB_RUNNER_2_CONTAINER")

TEST_POSTGRES_IMAGE="${TEST_POSTGRES_IMAGE:-docker.io/library/postgres:17-bookworm}"
TEST_S3_IMAGE="${TEST_S3_IMAGE:-docker.io/minio/minio:latest}"
TEST_S3_IMAGE_FALLBACK="${TEST_S3_IMAGE_FALLBACK:-quay.io/minio/minio:latest}"
TEST_RUST_IMAGE="${TEST_RUST_IMAGE:-docker.io/library/rust:1.88-bookworm}"
TEST_API_TEST_IMAGE="${TEST_API_TEST_IMAGE:-localhost/sortsys-api-test:rust-1.88-pg17}"
TEST_GO_IMAGE="${TEST_GO_IMAGE:-docker.io/library/golang:1.25}"
TEST_BUN_IMAGE="${TEST_BUN_IMAGE:-docker.io/oven/bun:1.3.12}"
TEST_CARGO_TARGET_DIR="${TEST_CARGO_TARGET_DIR:-/tmp/sortsys-api-v2-rust-target}"
TEST_CARGO_REGISTRY_DIR="${TEST_CARGO_REGISTRY_DIR:-/tmp/sortsys-api-v2-cargo-registry}"

TEST_API_PORT="${TEST_API_PORT:-}"
TEST_PG_PORT="${TEST_PG_PORT:-}"
TEST_S3_PORT="${TEST_S3_PORT:-}"

TEST_PG_PASSWORD="${TEST_PG_PASSWORD:-dev-postgres}"
TEST_S3_REGION="${TEST_S3_REGION:-us-east-1}"
TEST_S3_BUCKET="${TEST_S3_BUCKET:-sortsys-test}"
TEST_S3_ACCESS_KEY_ID="${TEST_S3_ACCESS_KEY_ID:-minioadmin}"
TEST_S3_SECRET_ACCESS_KEY="${TEST_S3_SECRET_ACCESS_KEY:-minioadmin}"
TEST_S3_PUBLIC_BASE_URL="${TEST_S3_PUBLIC_BASE_URL:-}"

TEST_JOB_RUNNER_TOKEN="${TEST_JOB_RUNNER_TOKEN:-test-job-runner-token}"
TEST_JWT_SECRET="${TEST_JWT_SECRET:-test-jwt-secret}"
TEST_LLM_ENCRYPTION_KEY="${TEST_LLM_ENCRYPTION_KEY:-test-llm-encryption-key}"
TEST_ADMIN_PASSWORD="${TEST_ADMIN_PASSWORD:-test-admin-password}"
TEST_ADMIN_HASH="${TEST_ADMIN_HASH:-\$2y\$04\$xUemhNQXp2VbrgKfIppnS.5nj9ovs9zOMPZuo.5rg4cyQvIDn5c2.}"

TEST_MASTER_DATABASE_NAME="${TEST_MASTER_DATABASE_NAME:-live_sortsys_api_test_tenants}"
TEST_LIVE_TENANT_NAME="${TEST_LIVE_TENANT_NAME:-test}"
TEST_MANAGED_DATABASE_NAME="${TEST_MANAGED_DATABASE_NAME:-live_sortsys_api_test}"
TEST_MANAGED_DATABASE_USER="${TEST_MANAGED_DATABASE_USER:-live_sortsys_api_test_app}"
TEST_LIVE_POSTGRES_HOST_NAME="${TEST_LIVE_POSTGRES_HOST_NAME:-test-local-postgres}"

TEST_ALL_CONTAINERS=(
  "$TEST_PG_CONTAINER"
  "$TEST_S3_CONTAINER"
  "$TEST_API_CONTAINER"
  "${TEST_JOB_RUNNER_CONTAINERS[0]}"
  "${TEST_JOB_RUNNER_CONTAINERS[1]}"
)

if command -v podman >/dev/null 2>&1; then
  CONTAINER_RUNTIME="podman"
elif command -v docker >/dev/null 2>&1; then
  CONTAINER_RUNTIME="docker"
else
  echo "podman or docker is required to run ./scripts/test-api"
  exit 1
fi

if [ ! -d "$API_DIR" ] || [ ! -d "$JOB_RUNNER_DIR" ]; then
  echo "expected monorepo directories are missing; run ./scripts/test-api from repository root"
  exit 1
fi

runtime_pull_args=()
runtime_user_args=()
runtime_mount_suffix=""
runtime_env_args=(-e HOME=/tmp -e NPM_CONFIG_CACHE=/tmp/.npm)

if [ "$CONTAINER_RUNTIME" = "podman" ]; then
  runtime_pull_args=(--pull=never)
  runtime_mount_suffix=":z"
fi

is_port_listening() {
  local port="$1"

  if command -v ss >/dev/null 2>&1; then
    ss -H -ltn "sport = :${port}" | grep -q .
    return $?
  fi

  if command -v netstat >/dev/null 2>&1; then
    netstat -ltn 2>/dev/null | grep -Eq "[\.:]${port}[[:space:]]"
    return $?
  fi

  if (exec 9<>"/dev/tcp/127.0.0.1/${port}") >/dev/null 2>&1; then
    exec 9>&-
    exec 9<&-
    return 0
  fi

  return 1
}

TEST_RESERVED_PORTS=()

is_reserved_test_port() {
  local port="$1"
  local reserved_port

  for reserved_port in "${TEST_RESERVED_PORTS[@]}"; do
    if [ "$reserved_port" = "$port" ]; then
      return 0
    fi
  done

  return 1
}

reserve_test_port() {
  local port="$1"
  TEST_RESERVED_PORTS+=("$port")
}

random_free_host_port() {
  local min="${1:-20000}"
  local max="${2:-59999}"
  local attempt
  local candidate

  for ((attempt = 1; attempt <= 500; attempt++)); do
    candidate="$((min + RANDOM % (max - min + 1)))"

    if is_reserved_test_port "$candidate"; then
      continue
    fi

    if is_port_listening "$candidate"; then
      continue
    fi

    echo "$candidate"
    return 0
  done

  echo "could not find a free random host port" >&2
  exit 1
}

resolve_ports() {
  if [ -z "$TEST_PG_PORT" ]; then
    TEST_PG_PORT="$(random_free_host_port)"
  fi
  reserve_test_port "$TEST_PG_PORT"

  if [ -z "$TEST_S3_PORT" ]; then
    TEST_S3_PORT="$(random_free_host_port)"
  fi
  reserve_test_port "$TEST_S3_PORT"

  if [ -z "$TEST_API_PORT" ]; then
    TEST_API_PORT="$(random_free_host_port)"
  fi
  reserve_test_port "$TEST_API_PORT"

  if [ "$TEST_API_PORT" = "$TEST_PG_PORT" ] || [ "$TEST_API_PORT" = "$TEST_S3_PORT" ] || [ "$TEST_PG_PORT" = "$TEST_S3_PORT" ]; then
    echo "TEST_API_PORT, TEST_PG_PORT and TEST_S3_PORT must be distinct" >&2
    exit 1
  fi

  if [ -z "$TEST_S3_PUBLIC_BASE_URL" ]; then
    TEST_S3_PUBLIC_BASE_URL="http://127.0.0.1:${TEST_S3_PORT}"
  fi
}

resolve_ports

mkdir -p "$TEST_CARGO_TARGET_DIR" "$TEST_CARGO_REGISTRY_DIR"

echo "Using test run suffix: ${TEST_RUN_SUFFIX}"
echo "Using test network: ${TEST_NETWORK}"
echo "Using test containers:"
echo "  pg=${TEST_PG_CONTAINER}"
echo "  s3=${TEST_S3_CONTAINER}"
echo "  api=${TEST_API_CONTAINER}"
echo "  job-runner-1=${TEST_JOB_RUNNER_CONTAINERS[0]}"
echo "  job-runner-2=${TEST_JOB_RUNNER_CONTAINERS[1]}"
echo "Using test ports: pg=${TEST_PG_PORT}, s3=${TEST_S3_PORT}, api=${TEST_API_PORT}"

image_exists() {
  local image="$1"

  if [ "$CONTAINER_RUNTIME" = "podman" ]; then
    podman image exists "$image" >/dev/null 2>&1
    return $?
  fi

  docker image inspect "$image" >/dev/null 2>&1
}

container_is_running() {
  local container_name="$1"
  local running

  running="$($CONTAINER_RUNTIME inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null || true)"
  [ "$running" = "true" ]
}

cleanup_containers() {
  for container_name in "${TEST_ALL_CONTAINERS[@]}"; do
    "$CONTAINER_RUNTIME" rm -f "$container_name" >/dev/null 2>&1 || true
  done
}

cleanup_network() {
  "$CONTAINER_RUNTIME" network rm "$TEST_NETWORK" >/dev/null 2>&1 || true
}

ensure_network() {
  if "$CONTAINER_RUNTIME" network inspect "$TEST_NETWORK" >/dev/null 2>&1; then
    return 0
  fi

  "$CONTAINER_RUNTIME" network create "$TEST_NETWORK" >/dev/null
}

ensure_image() {
  local image="$1"
  local retries="${2:-5}"

  if image_exists "$image"; then
    return 0
  fi

  echo "Pulling image ${image}"
  for ((i = 1; i <= retries; i++)); do
    if "$CONTAINER_RUNTIME" pull "$image" >/dev/null 2>&1; then
      return 0
    fi

    if [ "$i" -lt "$retries" ]; then
      echo "Pull failed (${i}/${retries}), retrying in 3s..."
      sleep 3
    fi
  done

  return 1
}

build_api_test_image() {
  echo "Building cached Rust API test image with PostgreSQL 17 clients"
  "$CONTAINER_RUNTIME" build \
    --build-arg "RUST_IMAGE=$TEST_RUST_IMAGE" \
    --file "$API_DIR/rust-api/Dockerfile.test" \
    --tag "$TEST_API_TEST_IMAGE" \
    "$API_DIR" >/dev/null
}

wait_for_container_log() {
  local container_name="$1"
  local pattern="$2"
  local label="$3"
  local timeout_sec="${4:-120}"

  for ((i = 1; i <= timeout_sec; i++)); do
    if ! container_is_running "$container_name"; then
      echo "${label} container stopped unexpectedly"
      "$CONTAINER_RUNTIME" logs "$container_name" || true
      return 1
    fi

    if "$CONTAINER_RUNTIME" logs "$container_name" 2>&1 | grep -Eq "$pattern"; then
      return 0
    fi

    sleep 1
  done

  echo "${label} did not become ready in time"
  "$CONTAINER_RUNTIME" logs "$container_name" || true
  return 1
}

copy_api_workspace_into_container() {
  local container_name="$1"

  # Podman requires the destination of a streamed archive to exist already.
  # Include the workspace directory in the archive and extract it below `/`,
  # which exists even before the container has been started.
  tar \
    --exclude=sortsys-api-v2/target \
    --exclude=sortsys-api-v2/client/node_modules \
    -C "$ROOT_DIR" \
    -cf - \
    sortsys-api-v2 |
    "$CONTAINER_RUNTIME" cp - "${container_name}:/"
}

copy_job_runner_workspace_into_container() {
  local container_name="$1"

  tar -C "$ROOT_DIR" -cf - sortsys-v2-job_runner |
    "$CONTAINER_RUNTIME" cp - "${container_name}:/"
}

validate_pg_identifier() {
  local value="$1"
  local field="$2"

  if ! [[ "$value" =~ ^[a-z][a-z0-9_]{0,62}$ ]]; then
    echo "Invalid ${field}: '${value}' (must match ^[a-z][a-z0-9_]{0,62}$)"
    exit 1
  fi
}

initialize_master_database() {
  validate_pg_identifier "$TEST_MASTER_DATABASE_NAME" "TEST_MASTER_DATABASE_NAME"
  validate_pg_identifier "$TEST_MANAGED_DATABASE_NAME" "TEST_MANAGED_DATABASE_NAME"
  validate_pg_identifier "$TEST_MANAGED_DATABASE_USER" "TEST_MANAGED_DATABASE_USER"

  echo "Initializing test master database ${TEST_MASTER_DATABASE_NAME}"
  "$CONTAINER_RUNTIME" exec "$TEST_PG_CONTAINER" psql -U postgres -v ON_ERROR_STOP=1 -d postgres \
    -c "SET client_min_messages TO WARNING;" \
    -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname IN ('${TEST_MASTER_DATABASE_NAME}', '${TEST_MANAGED_DATABASE_NAME}') AND pid <> pg_backend_pid();" \
    -c "DROP DATABASE IF EXISTS \"${TEST_MANAGED_DATABASE_NAME}\";" \
    -c "DROP DATABASE IF EXISTS \"${TEST_MASTER_DATABASE_NAME}\";" \
    -c "DROP ROLE IF EXISTS \"${TEST_MANAGED_DATABASE_USER}\";" \
    -c "CREATE DATABASE \"${TEST_MASTER_DATABASE_NAME}\";" >/dev/null
}

start_infra() {
  cleanup_containers
  cleanup_network
  ensure_network

  if ! ensure_image "$TEST_POSTGRES_IMAGE" 5; then
    echo "Failed to prepare postgres image: ${TEST_POSTGRES_IMAGE}"
    exit 1
  fi

  if ! ensure_image "$TEST_S3_IMAGE" 5; then
    echo "Failed to prepare S3 image: ${TEST_S3_IMAGE}"
    echo "Trying fallback image: ${TEST_S3_IMAGE_FALLBACK}"
    if ! ensure_image "$TEST_S3_IMAGE_FALLBACK" 5; then
      echo "Failed to prepare both primary and fallback S3 images"
      exit 1
    fi
    TEST_S3_IMAGE="$TEST_S3_IMAGE_FALLBACK"
  fi


  if ! ensure_image "$TEST_RUST_IMAGE" 5; then
    echo "Failed to prepare rust image: ${TEST_RUST_IMAGE}"
    exit 1
  fi

  build_api_test_image

  if ! ensure_image "$TEST_GO_IMAGE" 5; then
    echo "Failed to prepare go image: ${TEST_GO_IMAGE}"
    exit 1
  fi

  if ! ensure_image "$TEST_BUN_IMAGE" 5; then
    echo "Failed to prepare bun image: ${TEST_BUN_IMAGE}"
    exit 1
  fi

  echo "Starting PostgreSQL test container on port ${TEST_PG_PORT}"
  "$CONTAINER_RUNTIME" run -d \
    --name "$TEST_PG_CONTAINER" \
    "${runtime_pull_args[@]}" \
    --network "$TEST_NETWORK" \
    -p "${TEST_PG_PORT}:5432" \
    -e POSTGRES_HOST_AUTH_METHOD=trust \
    -e PG_HOST_AUTH_METHOD=trust \
    "$TEST_POSTGRES_IMAGE" >/dev/null

  echo "Waiting for PostgreSQL readiness"
  for ((i = 1; i <= 120; i++)); do
    if ! container_is_running "$TEST_PG_CONTAINER"; then
      echo "PostgreSQL container stopped unexpectedly"
      "$CONTAINER_RUNTIME" logs "$TEST_PG_CONTAINER" || true
      exit 1
    fi

    if "$CONTAINER_RUNTIME" exec "$TEST_PG_CONTAINER" pg_isready -U postgres >/dev/null 2>&1; then
      break
    fi

    if [ "$i" -eq 120 ]; then
      echo "PostgreSQL did not become ready in time"
      exit 1
    fi

    sleep 1
  done

  echo "Starting MinIO test container on port ${TEST_S3_PORT}"
  "$CONTAINER_RUNTIME" run -d \
    --name "$TEST_S3_CONTAINER" \
    "${runtime_pull_args[@]}" \
    --network "$TEST_NETWORK" \
    -p "${TEST_S3_PORT}:9000" \
    -e MINIO_ROOT_USER="$TEST_S3_ACCESS_KEY_ID" \
    -e MINIO_ROOT_PASSWORD="$TEST_S3_SECRET_ACCESS_KEY" \
    "$TEST_S3_IMAGE" server /data --address :9000 >/dev/null

  echo "Waiting for MinIO readiness"
  if ! wait_for_container_log "$TEST_S3_CONTAINER" 'API:\s+http://' "MinIO" 120; then
    exit 1
  fi

  echo "Initializing MinIO test bucket ${TEST_S3_BUCKET}"
  "$CONTAINER_RUNTIME" exec "$TEST_S3_CONTAINER" \
    mc alias set sortsys-test http://127.0.0.1:9000 \
      "$TEST_S3_ACCESS_KEY_ID" "$TEST_S3_SECRET_ACCESS_KEY" >/dev/null
  "$CONTAINER_RUNTIME" exec "$TEST_S3_CONTAINER" \
    mc mb --ignore-existing "sortsys-test/${TEST_S3_BUCKET}" >/dev/null
}

start_api_container() {
  local pg_master_dsn="postgres://postgres:${TEST_PG_PASSWORD}@${TEST_PG_CONTAINER}:5432/${TEST_MASTER_DATABASE_NAME}"

  echo "Starting API test container on port ${TEST_API_PORT}"
  "$CONTAINER_RUNTIME" create \
    --name "$TEST_API_CONTAINER" \
    "${runtime_pull_args[@]}" \
    "${runtime_user_args[@]}" \
    "${runtime_env_args[@]}" \
    --network "$TEST_NETWORK" \
    -p "${TEST_API_PORT}:3000" \
    -v "${TEST_CARGO_TARGET_DIR}:/sortsys-api-v2/target${runtime_mount_suffix}" \
    -v "${TEST_CARGO_REGISTRY_DIR}:/usr/local/cargo/registry${runtime_mount_suffix}" \
    -w /sortsys-api-v2 \
    -e PORT="3000" \
    -e PG_MASTER_DSN="$pg_master_dsn" \
    -e JWT_SECRET="$TEST_JWT_SECRET" \
    -e LLM_ENCRYPTION_KEY="$TEST_LLM_ENCRYPTION_KEY" \
    -e ADMIN_HASH="$TEST_ADMIN_HASH" \
    -e JOB_RUNNER_TOKEN="$TEST_JOB_RUNNER_TOKEN" \
    -e TEST_PG_HOST="$TEST_PG_CONTAINER" \
    -e TEST_PG_PORT="5432" \
    -e TEST_PG_USER="postgres" \
    -e TEST_PG_PASSWORD="$TEST_PG_PASSWORD" \
    -e DEV_MASTER_DATABASE_NAME="$TEST_MASTER_DATABASE_NAME" \
    -e DEV_TEST_TENANT_NAME="$TEST_LIVE_TENANT_NAME" \
    -e DEV_TEST_DATABASE_NAME="$TEST_MANAGED_DATABASE_NAME" \
    -e DEV_TEST_DATABASE_USER="$TEST_MANAGED_DATABASE_USER" \
    -e DEV_LIVE_POSTGRES_HOST_NAME="$TEST_LIVE_POSTGRES_HOST_NAME" \
    -e TEST_S3_ENDPOINT="http://${TEST_S3_CONTAINER}:9000" \
    -e TEST_S3_PUBLIC_BASE_URL="$TEST_S3_PUBLIC_BASE_URL" \
    -e TEST_S3_REGION="$TEST_S3_REGION" \
    -e TEST_S3_BUCKET="$TEST_S3_BUCKET" \
    -e TEST_S3_ACCESS_KEY_ID="$TEST_S3_ACCESS_KEY_ID" \
    -e TEST_S3_SECRET_ACCESS_KEY="$TEST_S3_SECRET_ACCESS_KEY" \
    -e TEST_S3_FORCE_PATH_STYLE="true" \
    "$TEST_API_TEST_IMAGE" \
    sh -c 'set -e; rustup component add rustfmt clippy; cargo run --locked --package sortsys-api --bin sortsys-api' >/dev/null

  copy_api_workspace_into_container "$TEST_API_CONTAINER"
  "$CONTAINER_RUNTIME" start "$TEST_API_CONTAINER" >/dev/null

  if ! wait_for_container_log "$TEST_API_CONTAINER" 'sortsys Rust API listening' "API" 240; then
    exit 1
  fi
}

start_job_runner_containers() {
  echo "Starting job runner test containers"
  for idx in "${!TEST_JOB_RUNNER_CONTAINERS[@]}"; do
    local container_name="${TEST_JOB_RUNNER_CONTAINERS[$idx]}"
    local runner_id="test-runner-$((idx + 1))"

    "$CONTAINER_RUNTIME" create \
      --name "$container_name" \
      "${runtime_pull_args[@]}" \
      "${runtime_user_args[@]}" \
      "${runtime_env_args[@]}" \
      --network "$TEST_NETWORK" \
      -w /sortsys-v2-job_runner \
      -e JOB_RUNNER_WS_URL="ws://${TEST_API_CONTAINER}:3000/internal/job-runners/ws" \
      -e JOB_RUNNER_TOKEN="$TEST_JOB_RUNNER_TOKEN" \
      -e JOB_RUNNER_ID="$runner_id" \
      -e GOCACHE=/tmp/go-build \
      -e GOPATH=/tmp/go \
      "$TEST_GO_IMAGE" \
      sh -lc 'set -e; export PATH="/usr/local/go/bin:$PATH"; go mod download; exec go run ./cmd/job-runner' >/dev/null

    copy_job_runner_workspace_into_container "$container_name"
    "$CONTAINER_RUNTIME" start "$container_name" >/dev/null

    if ! container_is_running "$container_name"; then
      echo "Job runner container failed to start: ${container_name}"
      "$CONTAINER_RUNTIME" logs "$container_name" || true
      exit 1
    fi
  done
}

api_exec() {
  "$CONTAINER_RUNTIME" exec \
    -w /sortsys-api-v2 \
    -e NODE_ENV=test \
    -e TEST_ADMIN_PASSWORD="$TEST_ADMIN_PASSWORD" \
    -e TEST_PG_HOST="$TEST_PG_CONTAINER" \
    -e TEST_PG_PORT="5432" \
    -e TEST_PG_USER="postgres" \
    -e TEST_PG_PASSWORD="$TEST_PG_PASSWORD" \
    -e TEST_S3_ENDPOINT="http://${TEST_S3_CONTAINER}:9000" \
    -e TEST_S3_PUBLIC_BASE_URL="http://${TEST_S3_CONTAINER}:9000" \
    -e TEST_S3_REGION="$TEST_S3_REGION" \
    -e TEST_S3_BUCKET="$TEST_S3_BUCKET" \
    -e TEST_S3_ACCESS_KEY_ID="$TEST_S3_ACCESS_KEY_ID" \
    -e TEST_S3_SECRET_ACCESS_KEY="$TEST_S3_SECRET_ACCESS_KEY" \
    -e TEST_S3_FORCE_PATH_STYLE="true" \
    "$TEST_API_CONTAINER" "$@"
}

run_api_tests() {
  echo "Running Rust API checks"
  # The password is test-only and must match TEST_ADMIN_HASH so network tests
  # can exercise admin.login instead of forging an administrator JWT.
  export TEST_ADMIN_PASSWORD
  api_exec cargo fmt --all --check
  api_exec cargo test --workspace
  api_exec cargo clippy --workspace --all-targets -- -D warnings
  api_exec cargo run --quiet --bin generate_contract -- --check

  echo "Running client checks (containerized bun)"
  "$CONTAINER_RUNTIME" run --rm \
    "${runtime_pull_args[@]}" \
    "${runtime_user_args[@]}" \
    "${runtime_env_args[@]}" \
    -v "${API_DIR}:/workspace/sortsys-api-v2${runtime_mount_suffix}" \
    -w /workspace/sortsys-api-v2/client \
    "$TEST_BUN_IMAGE" \
    sh -lc 'set -e; bun install; bun x tsc -p tsconfig.json --noEmit; bun test; bun run build'
}

on_exit() {
  local status=$?

  if [ "$status" -ne 0 ]; then
    echo
    echo "scripts/test-api failed. Container logs:"
    for container_name in "${TEST_ALL_CONTAINERS[@]}"; do
      echo "--- ${container_name} ---"
      "$CONTAINER_RUNTIME" logs "$container_name" || true
    done
  fi

  cleanup_containers
  cleanup_network
  exit "$status"
}

trap on_exit EXIT

start_infra
initialize_master_database
start_api_container
start_job_runner_containers
run_api_tests "$@"

echo
echo "scripts/test-api completed successfully"
