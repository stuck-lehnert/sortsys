#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_SUFFIX="${TEST_RUN_SUFFIX:-$(date +%s)-$RANDOM}"
TEST_CONTAINER="sortsys-native-tests-${RUN_SUFFIX}"
TEST_IMAGE="${TEST_API_TEST_IMAGE:-localhost/sortsys-api-test:rust-1.99-duckdb-2}"
TEST_LOG_DIR="${TEST_LOG_DIR:-/tmp/${TEST_CONTAINER}}"
TEST_CARGO_TARGET_DIR="${TEST_CARGO_TARGET_DIR:-/tmp/sortsys-native-cargo-target}"
TEST_CARGO_REGISTRY_DIR="${TEST_CARGO_REGISTRY_DIR:-/tmp/sortsys-native-cargo-registry}"
TEST_NATIVE_BROWSER="${TEST_NATIVE_BROWSER:-0}"
if [ "$TEST_NATIVE_BROWSER" != 0 ] && [ "$TEST_NATIVE_BROWSER" != 1 ]; then
  echo "TEST_NATIVE_BROWSER must be 0 or 1" >&2
  exit 1
fi
if [ "$TEST_NATIVE_BROWSER" = 1 ] && [ ! -f "$ROOT_DIR/sortsys-webapp-v2/build/client/index.html" ]; then
  echo "Build the webapp before running browser E2E tests" >&2
  exit 1
fi

if [ -z "${CONTAINER_RUNTIME:-}" ]; then
  if command -v podman >/dev/null 2>&1; then
    CONTAINER_RUNTIME=podman
  else
    CONTAINER_RUNTIME=docker
  fi
fi
case "$CONTAINER_RUNTIME" in
  docker|podman) ;;
  *) echo "CONTAINER_RUNTIME must be docker or podman" >&2; exit 1 ;;
esac
command -v "$CONTAINER_RUNTIME" >/dev/null

mount_suffix=""
if [ "$CONTAINER_RUNTIME" = podman ]; then
  mount_suffix=":z"
fi
mkdir -p "$TEST_LOG_DIR" "$TEST_CARGO_TARGET_DIR" "$TEST_CARGO_REGISTRY_DIR"
created=false
cleanup() {
  local status=$?
  trap - EXIT
  if [ "$created" = true ]; then
    "$CONTAINER_RUNTIME" cp "$TEST_CONTAINER:/tmp/test-logs/." "$TEST_LOG_DIR" || true
    "$CONTAINER_RUNTIME" rm -f "$TEST_CONTAINER" >/dev/null
  fi
  echo "API test logs: $TEST_LOG_DIR"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

"$CONTAINER_RUNTIME" build \
  --file "$ROOT_DIR/sortsys-api-v2/rust-api/Dockerfile.test" \
  --tag "$TEST_IMAGE" "$ROOT_DIR/sortsys-api-v2"
"$CONTAINER_RUNTIME" create --name "$TEST_CONTAINER" \
  -e SORTSYS_NATIVE_BROWSER="$TEST_NATIVE_BROWSER" \
  -v "${TEST_CARGO_TARGET_DIR}:/test-cache/target${mount_suffix}" \
  -v "${TEST_CARGO_REGISTRY_DIR}:/usr/local/cargo/registry${mount_suffix}" \
  "$TEST_IMAGE" bash /workspace/scripts/test-api-checks >/dev/null
created=true

# Copy a source snapshot; tests cannot change the checkout or read local secrets.
COPYFILE_DISABLE=1 tar -C "$ROOT_DIR" \
  --exclude=node_modules --exclude=target --exclude=dist --exclude=build \
  --exclude=.git --exclude=.env --exclude='.env.*' --exclude='.compose-env*' \
  --exclude=.npmrc --exclude=.aws --exclude=.ssh --exclude=.codex --exclude=.agents \
  --exclude='._*' --exclude=.DS_Store \
  --exclude='*.key' --exclude='*.pem' --exclude='*.p12' --exclude='*.pfx' \
  -cf - scripts sortsys-api-v2 sortsys-store sortsys-zerotrust \
  sortsys-webapp-v2 sortsys-gaeb sortsys-react-components sortsys-dwgviewer \
  | "$CONTAINER_RUNTIME" cp - "$TEST_CONTAINER:/workspace"
if [ "$TEST_NATIVE_BROWSER" = 1 ]; then
  COPYFILE_DISABLE=1 tar -C "$ROOT_DIR" -cf - sortsys-webapp-v2/build/client \
    | "$CONTAINER_RUNTIME" cp - "$TEST_CONTAINER:/workspace"
fi
"$CONTAINER_RUNTIME" start --attach "$TEST_CONTAINER"
status="$("$CONTAINER_RUNTIME" inspect --format '{{.State.ExitCode}}' "$TEST_CONTAINER")"
if [ "$status" -ne 0 ]; then
  exit "$status"
fi
echo "Native API checks passed."
