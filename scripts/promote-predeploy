#!/usr/bin/env bash
set -euo pipefail

CANDIDATE_SHA="${1:-}"
if ! [[ "$CANDIDATE_SHA" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Usage: scripts/promote-predeploy <tested-predeploy-commit>" >&2
  exit 1
fi

git fetch --no-tags origin \
  refs/heads/predeploy:refs/remotes/origin/predeploy \
  refs/heads/deploy:refs/remotes/origin/deploy

if [ "$(git rev-parse --verify refs/remotes/origin/predeploy)" != "$CANDIDATE_SHA" ]; then
  echo "predeploy advanced; refusing to promote a stale candidate." >&2
  exit 1
fi

if ! git merge-base --is-ancestor refs/remotes/origin/deploy "$CANDIDATE_SHA"; then
  echo "predeploy must contain the current deploy history." >&2
  exit 1
fi

# A normal push only fast-forwards. A concurrent divergent release is rejected
# by the remote; no force-push or separately pinned upgrade baseline is needed.
git push origin "${CANDIDATE_SHA}:refs/heads/deploy"
