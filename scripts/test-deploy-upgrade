#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEPLOY_SHA="${1:-}"

if ! [[ "$DEPLOY_SHA" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Usage: scripts/test-deploy-upgrade <exact-deploy-commit>" >&2
  exit 1
fi

shift
cd "$ROOT_DIR"
git cat-file -e "${DEPLOY_SHA}^{commit}"

if ! git merge-base --is-ancestor "$DEPLOY_SHA" HEAD; then
  echo "The candidate must contain the tested deploy history." >&2
  exit 1
fi

BASELINE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/sortsys-deploy-baseline.XXXXXXXX")"
trap 'rm -rf "$BASELINE_DIR"' EXIT

# Only deploy source is extracted; candidate code cannot seed the old schema.
git archive "$DEPLOY_SHA" sortsys-api-v2 | tar -xf - -C "$BASELINE_DIR"

export TEST_UPGRADE_FROM_DIR="$BASELINE_DIR"
# Keep each deploy revision separate from candidate and other deploy artifacts.
CARGO_TARGET_ROOT="${TEST_CARGO_TARGET_DIR:-/tmp/sortsys-api-v2-rust-target}"
export TEST_BASELINE_CARGO_TARGET_DIR="${CARGO_TARGET_ROOT}-deploy/${DEPLOY_SHA}"
export TEST_API_START_TIMEOUT="${TEST_API_START_TIMEOUT:-900}"

echo "Testing deploy upgrade: ${DEPLOY_SHA} -> $(git rev-parse HEAD)"
"$ROOT_DIR/scripts/test-api" "$@"
