#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/container-images.sh"
SERVER_DIR="$ROOT_DIR/sortsys-api-v2"
CLIENT_DIR="$ROOT_DIR/sortsys-webapp-v2"
DEV_ENV_FILE="${DEV_ENV_FILE:-$ROOT_DIR/.env}"

DEV_STACK_NAME="${DEV_STACK_NAME:-sortsys-dev-zt}"
if [[ ! "$DEV_STACK_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
  echo "DEV_STACK_NAME enthält ungültige Zeichen" >&2
  exit 1
fi
DEV_NETWORK="${DEV_STACK_NAME}-network"
DEV_OFFICE_CONTAINER="${DEV_STACK_NAME}-office"
DEV_DRAWIO_CONTAINER="${DEV_STACK_NAME}-drawio"
DEV_API_CONTAINER="${DEV_STACK_NAME}-api"
DEV_DUCKDB_CONTAINER="${DEV_STACK_NAME}-duckdb"
DEV_DUCKDB_TOKEN="${DEV_DUCKDB_TOKEN:-sortsys-development-duckdb-token-not-for-production}"
DEV_WEBAPP_CONTAINER="${DEV_STACK_NAME}-webapp"
DEV_CLIENT_BUILD_CONTAINER="${DEV_STACK_NAME}-client-build"
DEV_SEED_CONTAINER="${DEV_STACK_NAME}-seed"
DEV_DATA_DIR="${DEV_DATA_DIR:-$ROOT_DIR/.dev-data/zerotrust}"
DEV_PRESERVE_FAILED_API=false
# Keep the seeded environment independent of already claimed draft tenants.
DEV_DUCKDB_DATA_DIR="$DEV_DATA_DIR/seeded-duckdb"
DEV_WEBAPP_DEPS_DIR="$DEV_DATA_DIR/webapp-dependencies"
DEV_DWG_DEPS_DIR="$DEV_DATA_DIR/dwgviewer-dependencies"
DEV_GAEB_DEPS_DIR="$DEV_DATA_DIR/gaeb-dependencies"
DEV_OFFICE_DATA_DIR="$DEV_DATA_DIR/private-office"
DEV_SEED_DATA_DIR="$DEV_DATA_DIR/seed"

DEV_OFFICE_IMAGE="${DEV_OFFICE_IMAGE:-localhost/sortsys-private-office:dev}"
DEV_DRAWIO_IMAGE="${DEV_DRAWIO_IMAGE:-$(sortsys_container_image drawio)}"
DEV_BUN_IMAGE="${DEV_BUN_IMAGE:-$(sortsys_container_image bun)}"
DEV_RUST_IMAGE="${DEV_RUST_IMAGE:-$(sortsys_container_image rust)}"
DEV_API_IMAGE="${DEV_API_IMAGE:-localhost/sortsys-api-dev:rust-1.99-duckdb-2}"
DEV_NODE_IMAGE="${DEV_NODE_IMAGE:-$(sortsys_container_image node)}"
DEV_REVISION="$(git -C "$ROOT_DIR" rev-parse --verify HEAD 2>/dev/null || printf development)"

DEV_API_PORT="${DEV_API_PORT:-3000}"
DEV_WEBAPP_PORT="${DEV_WEBAPP_PORT:-5173}"
DEV_OFFICE_PORT="${DEV_OFFICE_PORT:-39180}"
DEV_OFFICE_SANDBOX_PORT="${DEV_OFFICE_SANDBOX_PORT:-39182}"
DEV_OFFICE_PUBLIC_ORIGIN="${DEV_OFFICE_PUBLIC_ORIGIN:-http://127.0.0.1:${DEV_OFFICE_PORT}}"
DEV_OFFICE_SANDBOX_ORIGIN="${DEV_OFFICE_SANDBOX_ORIGIN:-http://127.0.0.1:${DEV_OFFICE_SANDBOX_PORT}}"
DEV_SORTSYS_PUBLIC_ORIGIN="${DEV_SORTSYS_PUBLIC_ORIGIN:-http://127.0.0.1:${DEV_WEBAPP_PORT}}"
DEV_DRAWIO_PORT="${DEV_DRAWIO_PORT:-39181}"
DEV_DRAWIO_PUBLIC_URL="${DEV_DRAWIO_PUBLIC_URL:-http://127.0.0.1:${DEV_DRAWIO_PORT}}"

DEV_JWT_SECRET="${DEV_JWT_SECRET:-sortsys-development-api-signing-secret-not-for-production}"
# Development global-admin password: 123456
DEV_ADMIN_PASSWORD="${DEV_ADMIN_PASSWORD:-123456}"
DEV_ADMIN_HASH="${DEV_ADMIN_HASH:-\$2y\$12\$A20B6GFXZPxMInilSMwRy.q3tixzPl9Bq0tgyrCvNAHUQI2BHqlPa}"

DEV_OPTIONAL_EDITOR_CONTAINERS=(
  "$DEV_OFFICE_CONTAINER"
  "$DEV_DRAWIO_CONTAINER"
)

DEV_SERVICE_CONTAINERS=(
  "$DEV_API_CONTAINER"
  "$DEV_DUCKDB_CONTAINER"
  "$DEV_WEBAPP_CONTAINER"
)

# Optional editors and short-lived helpers are cleaned up with the core stack.
# Only required services can stop the stack when they fail.
DEV_ALL_CONTAINERS=(
  "${DEV_SERVICE_CONTAINERS[@]}"
  "${DEV_OPTIONAL_EDITOR_CONTAINERS[@]}"
  "$DEV_CLIENT_BUILD_CONTAINER"
  "$DEV_SEED_CONTAINER"
)

if [ -n "${CONTAINER_RUNTIME:-}" ]; then
  if [[ "$CONTAINER_RUNTIME" != "docker" && "$CONTAINER_RUNTIME" != "podman" ]]; then
    echo "CONTAINER_RUNTIME muss docker oder podman sein" >&2
    exit 1
  fi
  command -v "$CONTAINER_RUNTIME" >/dev/null
elif command -v podman >/dev/null 2>&1; then
  CONTAINER_RUNTIME="podman"
elif command -v docker >/dev/null 2>&1; then
  CONTAINER_RUNTIME="docker"
else
  echo "podman or docker is required to run ./dev"
  exit 1
fi

if [ ! -d "$SERVER_DIR" ] || [ ! -d "$CLIENT_DIR" ]; then
  echo "expected monorepo directories are missing; run ./dev from the repository root"
  exit 1
fi

runtime_pull_args=(--pull=missing)
# The initializer and services share these binds on SELinux-enabled hosts.
runtime_mount_suffix=":z"
runtime_env_args=(-e HOME=/tmp -e NPM_CONFIG_CACHE=/tmp/.npm)
DEV_LLM_ENV_CONTENT=""

if [ "$CONTAINER_RUNTIME" = "podman" ]; then
  runtime_pull_args=(--pull=never)
fi

prepare_llm_environment() {
  local source_file="$DEV_ENV_FILE"

  if [ ! -f "$source_file" ]; then
    source_file="/dev/null"
  fi

  # Parse only the supported LLM settings. Do not source .env: it is data, not
  # trusted shell code. Already exported variables override values from the file.
  DEV_LLM_ENV_CONTENT="$(awk '
    BEGIN {
      names[1] = "OPENAI_API_KEY"
      names[2] = "OPENAI_MODEL"
      names[3] = "ANTHROPIC_API_KEY"
      names[4] = "ANTHROPIC_MODEL"
      names[5] = "DEEPSEEK_API_KEY"
      names[6] = "DEEPSEEK_MODEL"
      names[7] = "LLAMA_API_KEY"
      names[8] = "LLAMA_MODEL"
      names[9] = "META_API_KEY"
      names[10] = "META_MODEL"
      names[11] = "LLM_MCP_URL"
      names[12] = "OPENROUTER_API_KEY"
      names[13] = "OPENROUTER_MODEL"
      names[14] = "LLM_ENCRYPTION_KEY"
      names[15] = "LLM_LIVE_INTERNAL_URL"

      for (position = 1; position <= 15; position++) {
        allowed[names[position]] = 1
      }
    }

    {
      line = $0
      sub(/\r$/, "", line)
      sub(/^[ \t]*/, "", line)

      if (line == "" || line ~ /^#/) next

      sub(/^export[ \t]+/, "", line)
      separator = index(line, "=")
      if (separator == 0) next

      key = substr(line, 1, separator - 1)
      sub(/[ \t]*$/, "", key)
      if (!(key in allowed)) next

      value = substr(line, separator + 1)
      sub(/^[ \t]*/, "", value)
      sub(/[ \t]*$/, "", value)

      first = substr(value, 1, 1)
      last = substr(value, length(value), 1)
      if ((first == "\"" && last == "\"") || (first == "\047" && last == "\047")) {
        value = substr(value, 2, length(value) - 2)
      }

      values[key] = value
    }

    END {
      for (position = 1; position <= 15; position++) {
        key = names[position]

        if (key in ENVIRON) {
          print key "=" ENVIRON[key]
        } else if (key in values) {
          print key "=" values[key]
        }
      }
    }
  ' "$source_file")"

  if [ -n "$DEV_LLM_ENV_CONTENT" ]; then
    echo "Using development LLM configuration"
  else
    echo "No development LLM credentials found; assistant remains disabled"
  fi
}

cleanup_llm_environment() {
  DEV_LLM_ENV_CONTENT=""
}

image_exists() {
  local image="$1"

  if [ "$CONTAINER_RUNTIME" = "podman" ]; then
    podman image exists "$image" >/dev/null 2>&1
    return $?
  fi

  docker image inspect "$image" >/dev/null 2>&1
}

container_is_running() {
  local container_name="$1"
  local running

  running="$($CONTAINER_RUNTIME inspect -f '{{.State.Running}}' "$container_name" 2>/dev/null || true)"
  [ "$running" = "true" ]
}

prepare_development_directories() {
  # Services initialize ownership inside their own bind-mounted data folders.
  # Do not recursively chmod/chown existing database files on the host.
  mkdir -p \
    "$DEV_DUCKDB_DATA_DIR" \
    "$DEV_WEBAPP_DEPS_DIR" \
    "$DEV_DWG_DEPS_DIR" \
    "$DEV_GAEB_DEPS_DIR" \
    "$DEV_SEED_DATA_DIR" \
    "$DEV_OFFICE_DATA_DIR"
}

cleanup_containers() {
  local pids=()

  for container_name in "${DEV_ALL_CONTAINERS[@]}"; do
    if [ "$container_name" = "$DEV_API_CONTAINER" ] && [ "${DEV_PRESERVE_FAILED_API:-false}" = true ]; then
      continue
    fi
    "$CONTAINER_RUNTIME" rm -f "$container_name" >/dev/null 2>&1 &
    pids+=("$!")
  done

  for pid in "${pids[@]}"; do
    wait "$pid" || true
  done
}

kill_containers() {
  local pids=()

  for container_name in "${DEV_ALL_CONTAINERS[@]}"; do
    "$CONTAINER_RUNTIME" kill "$container_name" >/dev/null 2>&1 &
    pids+=("$!")
  done

  for pid in "${pids[@]}"; do
    wait "$pid" || true
  done
}

cleanup_network() {
  "$CONTAINER_RUNTIME" network rm "$DEV_NETWORK" >/dev/null 2>&1 || true
}

ensure_network() {
  local create_output

  if ! create_output="$($CONTAINER_RUNTIME network create "$DEV_NETWORK" 2>&1)"; then
    if ! "$CONTAINER_RUNTIME" network inspect "$DEV_NETWORK" >/dev/null 2>&1; then
      echo "$create_output" >&2
      return 1
    fi
  fi
}

ensure_image() {
  local image="$1"
  local retries="${2:-5}"
  local attempt
  local line

  if image_exists "$image"; then
    echo "Using cached image ${image}"
    return 0
  fi

  for ((attempt = 1; attempt <= retries; attempt++)); do
    echo "Pulling image ${image} (attempt ${attempt}/${retries})"

    # Prefix live output so concurrent pulls remain attributable to their image.
    # pipefail preserves a failed pull even when the output reader succeeds.
    if "$CONTAINER_RUNTIME" pull "$image" 2>&1 |
      while IFS= read -r line || [ -n "$line" ]; do
        printf '[%s] %s\n' "$image" "$line"
      done; then
      echo "Image ready: ${image}"
      return 0
    fi

    if [ "$attempt" -lt "$retries" ]; then
      echo "Pull failed for ${image} (${attempt}/${retries}), retrying in 3s..." >&2
      sleep 3
    fi
  done

  return 1
}

wait_for_startup_step() {
  local pid="$1"
  local label="$2"

  echo "Waiting for ${label}"

  if ! wait "$pid"; then
    echo "${label} startup failed" >&2
    return 1
  fi

  echo "${label} is ready"
}

start_optional_editor() {
  local label="$1"
  local starter="$2"

  if "$starter"; then
    echo "${label} is ready"
  else
    echo "${label} is unavailable; the API and webapp can continue running." >&2
  fi
}

wait_for_editor_ready() {
  local container_name="$1"
  local url="$2"
  local label="$3"
  local timeout_sec="$4"
  local deadline=$((SECONDS + timeout_sec))
  local next_report=$((SECONDS + 10))
  local probe_timeout

  echo "Waiting for ${label}; editor startup does not block the API or webapp"

  while [ "$SECONDS" -lt "$deadline" ]; do
    if ! container_is_running "$container_name"; then
      echo "${label} container stopped during startup" >&2
      "$CONTAINER_RUNTIME" inspect --format \
        'Exit code={{.State.ExitCode}}; OOM killed={{.State.OOMKilled}}; error={{.State.Error}}' \
        "$container_name" >&2 || true
      "$CONTAINER_RUNTIME" logs --tail 50 "$container_name" || true
      return 1
    fi

    probe_timeout=$((deadline - SECONDS))

    if [ "$probe_timeout" -gt 3 ]; then
      probe_timeout=3
    fi

    if [ "$probe_timeout" -le 0 ]; then
      break
    fi

    local probe=(curl --fail --silent --connect-timeout 2 --max-time "$probe_timeout" "$url")
    if [ "$container_name" = "${DEV_OFFICE_CONTAINER:-}" ]; then
      probe=(node /opt/sortsys-office/run.cjs --health)
    fi
    if "$CONTAINER_RUNTIME" exec "$container_name" "${probe[@]}" >/dev/null 2>&1; then
      return 0
    fi

    if [ "$SECONDS" -ge "$next_report" ]; then
      echo "${label} is still starting; inspect logs with:"
      echo "  ${CONTAINER_RUNTIME} logs -f ${container_name}"
      next_report=$((SECONDS + 10))
    fi

    sleep 1
  done

  echo "${label} did not become ready within ${timeout_sec}s" >&2
  "$CONTAINER_RUNTIME" logs --tail 50 "$container_name" || true
  return 1
}

wait_for_tcp_port() {
  local host="$1"
  local port="$2"
  local label="$3"
  local timeout_sec="${4:-120}"
  local container_name="${5:-}"
  local i

  echo "Waiting for ${label} on ${host}:${port} (up to ${timeout_sec}s)"

  for ((i = 1; i <= timeout_sec; i++)); do
    if [ -n "$container_name" ] && ! container_is_running "$container_name"; then
      echo "${label} container stopped during startup" >&2
      return 1
    fi

    if (exec 3<>"/dev/tcp/${host}/${port}") >/dev/null 2>&1; then
      exec 3>&-
      exec 3<&-
      return 0
    fi

    if ((i % 10 == 0)); then
      echo "${label} is still starting (${i}s)"
    fi

    sleep 1
  done

  echo "${label} did not become reachable on ${host}:${port}"
  return 1
}

wait_for_api_ready() {
  local attempt

  echo "Waiting for native API startup after compilation"
  echo "Inspect compiler progress: ${CONTAINER_RUNTIME} logs -f ${DEV_API_CONTAINER}"

  for ((attempt = 1; attempt <= 600; attempt++)); do
    if ! container_is_running "$DEV_API_CONTAINER"; then
      echo "API container stopped during startup" >&2
      DEV_PRESERVE_FAILED_API=true
      "$CONTAINER_RUNTIME" inspect --format \
        'Exit code={{.State.ExitCode}}; OOM killed={{.State.OOMKilled}}; error={{.State.Error}}' \
        "$DEV_API_CONTAINER" >&2 || true
      echo "Failed API container retained: ${CONTAINER_RUNTIME} logs ${DEV_API_CONTAINER}" >&2
      return 1
    fi
    if "$CONTAINER_RUNTIME" exec "$DEV_API_CONTAINER" \
      curl --fail --silent --max-time 2 "http://127.0.0.1:${DEV_API_PORT}/ping" >/dev/null 2>&1; then
      return 0
    fi

    if ((attempt % 10 == 0)); then
      echo "API compilation or startup is still running (${attempt}s)"
    fi

    sleep 1
  done

  echo "API did not finish startup in time" >&2
  return 1
}

prepare_images() {
  local images=("$DEV_DRAWIO_IMAGE" "$DEV_BUN_IMAGE" "$DEV_RUST_IMAGE" "$DEV_NODE_IMAGE")
  local pids=()
  local index
  for image in "${images[@]}"; do
    ensure_image "$image" 5 &
    pids+=("$!")
  done
  for index in "${!pids[@]}"; do
    wait_for_startup_step "${pids[$index]}" "${images[$index]}"
  done
}

build_private_office_image() {
  local load_args=()
  if [ "$CONTAINER_RUNTIME" = docker ]; then load_args=(--load); fi
  "$CONTAINER_RUNTIME" build "${load_args[@]}" -t "$DEV_OFFICE_IMAGE" "$ROOT_DIR/sortsys-office"
}

start_private_office() {
  echo "Starting development private Office on ports ${DEV_OFFICE_PORT} and ${DEV_OFFICE_SANDBOX_PORT}"
  ensure_network || return 1
  build_private_office_image || return 1
  if ! "$CONTAINER_RUNTIME" run -d \
    --name "$DEV_OFFICE_CONTAINER" \
    "${runtime_pull_args[@]}" \
    --network "$DEV_NETWORK" \
    --user "$(id -u):$(id -g)" \
    --read-only --init --cap-drop ALL --security-opt no-new-privileges \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=256m,mode=1777 \
    -p "127.0.0.1:${DEV_OFFICE_PORT}:8080" \
    -p "127.0.0.1:${DEV_OFFICE_SANDBOX_PORT}:8080" \
    -e OFFICE_PUBLIC_ORIGIN="$DEV_OFFICE_PUBLIC_ORIGIN" \
    -e OFFICE_SANDBOX_ORIGIN="$DEV_OFFICE_SANDBOX_ORIGIN" \
    -e SORTSYS_PUBLIC_ORIGIN="$DEV_SORTSYS_PUBLIC_ORIGIN" \
    -v "${DEV_OFFICE_DATA_DIR}:/var/lib/sortsys-office${runtime_mount_suffix}" \
    "$DEV_OFFICE_IMAGE" >/dev/null; then
    return 1
  fi
  wait_for_editor_ready "$DEV_OFFICE_CONTAINER" "" "Office" 180
}

start_drawio() {
  echo "Starting development diagrams.net on port ${DEV_DRAWIO_PORT}"

  ensure_network || return 1

  if ! "$CONTAINER_RUNTIME" run -d \
    --rm \
    --name "$DEV_DRAWIO_CONTAINER" \
    "${runtime_pull_args[@]}" \
    --network "$DEV_NETWORK" \
    -p "${DEV_DRAWIO_PORT}:8080" \
    -e DRAWIO_SERVER_URL="/" \
    -e DRAWIO_BASE_URL="" \
    "$DEV_DRAWIO_IMAGE" >/dev/null; then
    return 1
  fi

  wait_for_editor_ready "$DEV_DRAWIO_CONTAINER" \
    http://127.0.0.1:8080/ "diagrams.net" 180
}

ensure_local_api_client_package() {
  echo "Checking local API client package"

  "$CONTAINER_RUNTIME" run --rm \
    --name "$DEV_CLIENT_BUILD_CONTAINER" \
    "${runtime_pull_args[@]}" \
    "${runtime_env_args[@]}" \
    -v "${ROOT_DIR}:/workspace${runtime_mount_suffix}" \
    -w /workspace/sortsys-api-v2/client \
    "$DEV_BUN_IMAGE" \
    sh -lc '
      set -eu

      if bun ./scripts/check-dist-current.mjs; then
        echo "Local API client package is current"
      else
        echo "Client inputs changed; rebuilding local API client package"
        bun install
        bun run build
      fi
    '
}

build_api_development_image() {
  echo "Building Rust/DuckDB development image"
  "$CONTAINER_RUNTIME" build \
    --build-arg "RUST_IMAGE=$DEV_RUST_IMAGE" \
    --file "$SERVER_DIR/rust-api/Dockerfile.development" \
    --tag "$DEV_API_IMAGE" \
    "$SERVER_DIR" >/dev/null
}

start_duckdb_container() {
  echo "Starting shared development DuckDB service"
  "$CONTAINER_RUNTIME" run -d \
    --name "$DEV_DUCKDB_CONTAINER" \
    "${runtime_pull_args[@]}" \
    "${runtime_env_args[@]}" \
    --network "$DEV_NETWORK" \
    -v "${ROOT_DIR}:/workspace${runtime_mount_suffix}" \
    -v "${DEV_DUCKDB_DATA_DIR}:/data${runtime_mount_suffix}" \
    -w /workspace/sortsys-api-v2 \
    -e DUCKDB_SERVICE_TOKEN="$DEV_DUCKDB_TOKEN" \
    -e DUCKDB_DATA_DIRECTORY=/data \
    "$DEV_API_IMAGE" \
    cargo run --manifest-path /workspace/sortsys-store/Cargo.toml --target-dir /workspace/sortsys-api-v2/target --locked --bin sortsys-duckdb >/dev/null
  for ((attempt=1; attempt<=240; attempt++)); do
    if ! container_is_running "$DEV_DUCKDB_CONTAINER"; then
      "$CONTAINER_RUNTIME" logs "$DEV_DUCKDB_CONTAINER" >&2 || true
      return 1
    fi
    if "$CONTAINER_RUNTIME" exec "$DEV_DUCKDB_CONTAINER" /workspace/sortsys-api-v2/target/debug/sortsys-duckdb --health >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo "DuckDB startup timed out; inspect ${DEV_DUCKDB_CONTAINER}" >&2
  return 1
}

start_api_container() {
  prepare_llm_environment
  echo "Starting independent API on port ${DEV_API_PORT}"
  printf '%s\n' "$DEV_LLM_ENV_CONTENT" | "$CONTAINER_RUNTIME" run -d \
    --name "$DEV_API_CONTAINER" \
    "${runtime_pull_args[@]}" \
    "${runtime_env_args[@]}" \
    --env-file /dev/stdin \
    --network "$DEV_NETWORK" \
    -p "127.0.0.1:${DEV_API_PORT}:${DEV_API_PORT}" \
    -v "${ROOT_DIR}:/workspace${runtime_mount_suffix}" \
    -w /workspace/sortsys-api-v2 \
    -e PORT="$DEV_API_PORT" \
    -e JWT_SECRET="$DEV_JWT_SECRET" \
    -e DUCKDB_QUACK_URI="quack:${DEV_DUCKDB_CONTAINER}:9494" \
    -e DUCKDB_CONTROL_URL="http://${DEV_DUCKDB_CONTAINER}:9495" \
    -e DUCKDB_SERVICE_TOKEN="$DEV_DUCKDB_TOKEN" \
    -e DUCKDB_QUACK_DISABLE_SSL="true" \
    -e OFFICE_PUBLIC_ORIGIN="$DEV_OFFICE_PUBLIC_ORIGIN" \
    -e DRAWIO_PUBLIC_URL="$DEV_DRAWIO_PUBLIC_URL" \
    -e ADMIN_HASH="$DEV_ADMIN_HASH" \
    "$DEV_API_IMAGE" \
    cargo run --locked --package sortsys-api --bin sortsys-api >/dev/null
  cleanup_llm_environment
  if ! wait_for_api_ready; then
    mkdir -p "$DEV_DATA_DIR/logs"
    "$CONTAINER_RUNTIME" logs "$DEV_API_CONTAINER" > "$DEV_DATA_DIR/logs/api-startup.log" 2>&1 || true
    tail -n 150 "$DEV_DATA_DIR/logs/api-startup.log" >&2
    echo "Full API startup log: $DEV_DATA_DIR/logs/api-startup.log" >&2
    return 1
  fi
}

start_webapp_container() {
  echo "Starting containerized webapp dev server on port ${DEV_WEBAPP_PORT}"
  "$CONTAINER_RUNTIME" run -d \
    --rm \
    --name "$DEV_WEBAPP_CONTAINER" \
    "${runtime_pull_args[@]}" \
    "${runtime_env_args[@]}" \
    --network "$DEV_NETWORK" \
    -p "${DEV_WEBAPP_PORT}:${DEV_WEBAPP_PORT}" \
    -v "${ROOT_DIR}:/workspace${runtime_mount_suffix}" \
    -w /workspace/sortsys-webapp-v2 \
    -v "${DEV_WEBAPP_DEPS_DIR}:/workspace/sortsys-webapp-v2/node_modules${runtime_mount_suffix}" \
    -v "${DEV_DWG_DEPS_DIR}:/workspace/sortsys-dwgviewer/node_modules${runtime_mount_suffix}" \
    -v "${DEV_GAEB_DEPS_DIR}:/workspace/sortsys-gaeb/node_modules${runtime_mount_suffix}" \
    -e CHOKIDAR_USEPOLLING="${CHOKIDAR_USEPOLLING:-true}" \
    -e DEV_WEBAPP_PORT="$DEV_WEBAPP_PORT" \
    -e VITE_API_PORT="$DEV_API_PORT" \
    -e SORTSYS_REVISION="$DEV_REVISION" \
    "$DEV_NODE_IMAGE" \
    sh -lc '
      set -eu

      dependency_hash() {
        directory="$1"
        extra_input="${2:-}"
        {
          sha256sum "$directory/package.json"
          if [ -f "$directory/package-lock.json" ]; then
            sha256sum "$directory/package-lock.json"
          fi
          if [ -n "$extra_input" ] && [ -f "$extra_input" ]; then
            sha256sum "$extra_input"
          fi
        } | sha256sum | cut -d" " -f1
      }

      ensure_dependencies() {
        directory="$1"
        install_mode="$2"
        extra_input="${3:-}"
        stamp="$directory/node_modules/.sortsys-dev-dependencies"
        expected="$(dependency_hash "$directory" "$extra_input")"
        actual=""

        if [ -f "$stamp" ]; then
          actual="$(sed -n "1p" "$stamp")"
        fi

        if [ ! -d "$directory/node_modules" ] || [ "$actual" != "$expected" ]; then
          echo "Installing dependencies for $(basename "$directory")"

          if [ "$install_mode" = "ci" ]; then
            npm --prefix "$directory" ci
          else
            npm --prefix "$directory" install
          fi

          printf "%s\n" "$expected" > "$stamp"
        else
          echo "Dependencies for $(basename "$directory") are current"
        fi
      }

      ensure_dependencies /workspace/sortsys-dwgviewer ci
      ensure_dependencies /workspace/sortsys-gaeb ci
      ensure_dependencies \
        /workspace/sortsys-webapp-v2 \
        install \
        /workspace/sortsys-api-v2/client/dist/package.json

      exec npm run dev -- --host 0.0.0.0 --port "$DEV_WEBAPP_PORT"
    ' >/dev/null

  if ! wait_for_tcp_port "127.0.0.1" "$DEV_WEBAPP_PORT" "Webapp" 240 "$DEV_WEBAPP_CONTAINER"; then
    "$CONTAINER_RUNTIME" logs "$DEV_WEBAPP_CONTAINER" || true
    return 1
  fi
}

seed_development_tenant() {
  echo "Preparing the encrypted development tenant"
  "$CONTAINER_RUNTIME" run --rm \
    --name "$DEV_SEED_CONTAINER" \
    --user "$(id -u):$(id -g)" \
    "${runtime_pull_args[@]}" \
    "${runtime_env_args[@]}" \
    --network "$DEV_NETWORK" \
    -v "${ROOT_DIR}:/workspace${runtime_mount_suffix}" \
    -v "${DEV_WEBAPP_DEPS_DIR}:/workspace/sortsys-webapp-v2/node_modules${runtime_mount_suffix}" \
    -v "${DEV_GAEB_DEPS_DIR}:/workspace/sortsys-gaeb/node_modules${runtime_mount_suffix}" \
    -v "${DEV_SEED_DATA_DIR}:/seed${runtime_mount_suffix}" \
    -w /workspace/sortsys-webapp-v2 \
    -e SORTSYS_DEVELOPMENT_SEED=1 \
    -e SORTSYS_DEV_API_URL="http://${DEV_API_CONTAINER}:${DEV_API_PORT}/" \
    -e SORTSYS_DEV_SEED_DIRECTORY=/seed \
    -e SORTSYS_DEV_ADMIN_PASSWORD="$DEV_ADMIN_PASSWORD" \
    "$DEV_BUN_IMAGE" bun scripts/seed-development.ts
}

monitor_containers() {
  local optional_missing=()
  local index
  local container_name

  while true; do
    for container_name in "${DEV_SERVICE_CONTAINERS[@]}"; do
      if ! container_is_running "$container_name"; then
        echo "Container stopped unexpectedly: ${container_name}"
        "$CONTAINER_RUNTIME" logs "$container_name" || true
        return 1
      fi
    done

    for index in "${!DEV_OPTIONAL_EDITOR_CONTAINERS[@]}"; do
      container_name="${DEV_OPTIONAL_EDITOR_CONTAINERS[$index]}"

      if container_is_running "$container_name"; then
        optional_missing[$index]=false
      elif [ "${optional_missing[$index]:-false}" != "true" ]; then
        echo "Optional editor ${container_name} is unavailable; the core stack is running." >&2
        echo "Inspect logs: ${CONTAINER_RUNTIME} logs --tail 50 ${container_name}" >&2
        optional_missing[$index]=true
      fi
    done

    sleep 2
  done
}

stop_background_jobs() {
  local pid

  for pid in $(jobs -pr); do
    kill "$pid" >/dev/null 2>&1 || true
  done

  wait >/dev/null 2>&1 || true
}

cleanup() {
  trap - INT TERM EXIT
  stop_background_jobs
  cleanup_llm_environment
  cleanup_containers
  cleanup_network
}

force_shutdown() {
  trap - INT TERM EXIT
  stop_background_jobs
  cleanup_llm_environment
  kill_containers
  cleanup_containers
  cleanup_network
  exit 130
}

trap force_shutdown INT TERM
trap cleanup EXIT

cleanup_containers
prepare_development_directories
ensure_network
prepare_images

start_optional_editor "Office" start_private_office &
start_optional_editor "diagrams.net" start_drawio &
build_api_development_image &
api_image_pid="$!"
(
  ensure_local_api_client_package
  start_webapp_container
) &
webapp_pid="$!"
wait_for_startup_step "$api_image_pid" "API development image build"

start_duckdb_container
start_api_container

wait_for_startup_step "$webapp_pid" "Webapp"
seed_development_tenant

echo
echo "Independent DuckDB development stack is running"
echo "- Data:     ${DEV_DUCKDB_DATA_DIR} (persistent)"
echo "- Mandant:  john.doe@test (Admin), frank.doe@test (normal); Passwort jeweils 123456"
echo "- Betreiberverwaltung: DEV_ADMIN_PASSWORD (Standard: 123456)"
echo "- API:      http://127.0.0.1:${DEV_API_PORT}"
echo "- Webapp:   http://127.0.0.1:${DEV_WEBAPP_PORT}"
echo "- Office: ${DEV_OFFICE_PUBLIC_ORIGIN}"
echo "- diagrams.net: ${DEV_DRAWIO_PUBLIC_URL}"
echo
echo "Use '${CONTAINER_RUNTIME} logs -f <container>' to inspect logs."
echo "Press Ctrl+C to stop and clean up all containers."

monitor_containers
