#!/usr/bin/env bash
set -euo pipefail

: "${GITHUB_OUTPUT:?}"
if [ "${GITHUB_REF:-}" != refs/heads/predeploy ]; then
  echo "reused=false" >> "$GITHUB_OUTPUT"
  exit 0
fi

: "${GITHUB_REPOSITORY:?}" "${GITHUB_SHA:?}" "${GITHUB_RUN_ID:?}"

# A commit includes its workflow and test definitions. Only a completed success
# of this repository's CI push workflow can replace this commit's tests.
if ! previous="$(
  gh api --method GET "repos/$GITHUB_REPOSITORY/actions/workflows/ci.yml/runs" \
    -f "head_sha=$GITHUB_SHA" -f event=push -f status=success -f per_page=100 |
    jq -r --arg sha "$GITHUB_SHA" --arg repository "$GITHUB_REPOSITORY" \
      --arg current "$GITHUB_RUN_ID" '
      first(.workflow_runs[] | select(
        .head_sha == $sha and
        .head_repository.full_name == $repository and
        .path == ".github/workflows/ci.yml" and
        .event == "push" and
        .status == "completed" and .conclusion == "success" and
        (.id | tostring) != $current
      ) | .html_url | select(type == "string" and length > 0)) // empty
    '
)"; then
  echo "::warning::Could not verify a previous CI success; running the tests."
  previous=""
fi

if [ -n "$previous" ]; then
  echo "reused=true" >> "$GITHUB_OUTPUT"
  printf 'CI already passed for %s: %s\n' "$GITHUB_SHA" "$previous"
else
  echo "reused=false" >> "$GITHUB_OUTPUT"
fi
