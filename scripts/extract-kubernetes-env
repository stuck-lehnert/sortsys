#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "error: $*" >&2
  exit 1
}

INPUT_FILE="$PWD/kubernetes.yml"
OUTPUT_FILE="$PWD/.k8s.env"
FORCE_OVERWRITE=0

usage() {
  cat <<'EOF'
Usage: ./scripts/extract-kubernetes-env [options]

Options:
  --input <path>           Kubernetes manifest path (default: ./kubernetes.yml)
  --output <path>          Output env file path (default: ./.k8s.env)
  --force                  Overwrite existing output file
  --help                   Show this help

This script expects a manifest generated by ./scripts/create-kubernetes-config
and extracts all supported config values into a .env-style file.

Example:
  ./scripts/extract-kubernetes-env --input ./kubernetes.yml --output ./.k8s.env --force
EOF
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --force)
        FORCE_OVERWRITE=1
        shift
        ;;
      --input)
        [ "$#" -ge 2 ] || fail "missing value for --input"
        INPUT_FILE="$2"
        shift 2
        ;;
      --output)
        [ "$#" -ge 2 ] || fail "missing value for --output"
        OUTPUT_FILE="$2"
        shift 2
        ;;
      --input=*)
        INPUT_FILE="${1#*=}"
        shift
        ;;
      --output=*)
        OUTPUT_FILE="${1#*=}"
        shift
        ;;
      *)
        fail "unexpected argument: $1"
        ;;
    esac
  done
}

parse_args "$@"

[ -f "$INPUT_FILE" ] || fail "input file not found: $INPUT_FILE"
command -v python3 >/dev/null 2>&1 || fail "python3 is required"

OUTPUT_DIR="$(dirname "$OUTPUT_FILE")"
[ -d "$OUTPUT_DIR" ] || fail "output directory does not exist: $OUTPUT_DIR"

if [ -f "$OUTPUT_FILE" ] && [ "$FORCE_OVERWRITE" -ne 1 ]; then
  read -r -p "$OUTPUT_FILE already exists. Overwrite? [y/N]: " overwrite
  case "$overwrite" in
    y|Y|yes|YES) ;;
    *)
      echo "Aborted."
      exit 0
      ;;
  esac
fi

TMP_OUTPUT="$(mktemp)"
trap 'rm -f "$TMP_OUTPUT"' EXIT

python3 - "$INPUT_FILE" > "$TMP_OUTPUT" <<'PY'
import base64
import json
import re
import sys
from pathlib import Path

ORDER = [
    "NAMESPACE",
    "REGISTRY_SERVER",
    "IMAGE_PULL_SECRET_NAME",
    "REGISTRY_USERNAME",
    "REGISTRY_PASSWORD",
    "API_IMAGE",
    "WEBAPP_IMAGE",
    "JOBRUNNER_IMAGE",
    "API_REPLICAS",
    "WEBAPP_REPLICAS",
    "JOBRUNNER_REPLICAS",
    "API_PORT",
    "API_NODE_PORT",
    "WEBAPP_NODE_PORT",
    "POSTGRES_IMAGE",
    "POSTGRES_SERVICE_NAME",
    "POSTGRES_STORAGE_SIZE",
    "POSTGRES_STORAGE_CLASS",
    "POSTGRES_DB",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "NODE_ENV",
    "OBJECT_STORAGE_PROXY_URL",
    "JOB_RUNNER_WS_URL",
    "NO_PROXY",
    "JWT_SECRET",
    "ADMIN_HASH",
    "JOB_RUNNER_TOKEN",
]

OPTIONAL_KEYS = {
    "POSTGRES_STORAGE_CLASS",
    "NO_PROXY",
}


def fail(message):
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def indent(line):
    return len(line) - len(line.lstrip(" "))


def parse_scalar(raw_value):
    value = raw_value.strip()
    if not value or value in {"null", "~"}:
        return ""
    if len(value) >= 2 and value[0] == "'" and value[-1] == "'":
        return value[1:-1].replace("''", "'")
    if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
        inner = value[1:-1]
        try:
            return bytes(inner, "utf-8").decode("unicode_escape")
        except Exception:
            return inner
    return value


def split_docs(text):
    docs = []
    current = []
    for line in text.splitlines():
        if line.strip() == "---":
            if current:
                docs.append(current)
                current = []
            continue
        current.append(line.rstrip("\n"))
    if current:
        docs.append(current)
    return docs


def extract_metadata_field(lines, field_name):
    metadata_re = re.compile(r"^(\s*)metadata:\s*$")
    field_re = re.compile(rf"^\s*{re.escape(field_name)}:\s*(.+)\s*$")
    for index, line in enumerate(lines):
        metadata_match = metadata_re.match(line)
        if not metadata_match:
            continue
        metadata_indent = len(metadata_match.group(1))
        for nested in lines[index + 1 :]:
            nested_stripped = nested.strip()
            if not nested_stripped:
                continue
            nested_indent = indent(nested)
            if nested_indent <= metadata_indent:
                break
            if nested_indent != metadata_indent + 2:
                continue
            nested_match = field_re.match(nested)
            if nested_match:
                return parse_scalar(nested_match.group(1))
        break
    return ""


def extract_first_key(lines, key_name):
    key_re = re.compile(rf"^\s*{re.escape(key_name)}:\s*(.+)\s*$")
    for line in lines:
        match = key_re.match(line)
        if match:
            return parse_scalar(match.group(1))
    return ""


def extract_map(lines, section_name):
    section_re = re.compile(rf"^(\s*){re.escape(section_name)}:\s*$")
    key_re = re.compile(r"^\s*([A-Za-z0-9_.-]+):\s*(.*)\s*$")
    section_index = -1
    section_indent = -1

    for index, line in enumerate(lines):
        section_match = section_re.match(line)
        if section_match:
            section_index = index
            section_indent = len(section_match.group(1))
            break

    if section_index == -1:
        return {}

    out = {}
    i = section_index + 1
    while i < len(lines):
        line = lines[i]
        stripped = line.strip()
        if not stripped:
            i += 1
            continue

        line_indent = indent(line)
        if line_indent <= section_indent:
            break

        key_match = key_re.match(line)
        if not key_match or line_indent != section_indent + 2:
            i += 1
            continue

        key = key_match.group(1)
        raw_value = key_match.group(2)
        if raw_value in {"|", "|-", "|+"}:
            block_lines = []
            i += 1
            while i < len(lines):
                block_line = lines[i]
                block_stripped = block_line.strip()
                block_indent = indent(block_line)

                if block_stripped and block_indent <= line_indent:
                    break

                if not block_stripped:
                    block_lines.append("")
                    i += 1
                    continue

                content_indent = line_indent + 2
                if len(block_line) >= content_indent:
                    block_lines.append(block_line[content_indent:])
                else:
                    block_lines.append("")
                i += 1

            while block_lines and block_lines[-1] == "":
                block_lines.pop()

            out[key] = "\n".join(block_lines)
            continue

        out[key] = parse_scalar(raw_value)
        i += 1

    return out


def extract_first_pull_secret_name(lines):
    section_re = re.compile(r"^(\s*)imagePullSecrets:\s*$")
    item_re = re.compile(r"^\s*-\s*name:\s*(.+)\s*$")
    section_indent = -1
    section_index = -1

    for index, line in enumerate(lines):
        section_match = section_re.match(line)
        if section_match:
            section_indent = len(section_match.group(1))
            section_index = index
            break

    if section_index == -1:
        return ""

    for line in lines[section_index + 1 :]:
        stripped = line.strip()
        if not stripped:
            continue

        line_indent = indent(line)
        if line_indent <= section_indent:
            break

        item_match = item_re.match(line)
        if item_match:
            return parse_scalar(item_match.group(1))

    return ""


def decode_base64(value):
    try:
        return base64.b64decode(value).decode("utf-8")
    except Exception:
        return ""


def decode_data_map(data_map):
    decoded = {}
    for key, value in data_map.items():
        decoded[key] = decode_base64(value)
    return decoded


input_path = Path(sys.argv[1])
if not input_path.is_file():
    fail(f"input file not found: {input_path}")

try:
    text = input_path.read_text(encoding="utf-8")
except Exception as exc:
    fail(f"failed to read {input_path}: {exc}")

doc_lines = split_docs(text)
if not doc_lines:
    fail("no YAML documents found")

docs = []
for lines in doc_lines:
    docs.append(
        {
            "lines": lines,
            "kind": extract_first_key(lines, "kind"),
            "name": extract_metadata_field(lines, "name"),
            "type": extract_first_key(lines, "type"),
        }
    )


def find_doc(kind="", name="", type_value=""):
    for doc in docs:
        if kind and doc["kind"] != kind:
            continue
        if name and doc["name"] != name:
            continue
        if type_value and doc["type"] != type_value:
            continue
        return doc
    return None


def secret_values(secret_doc):
    lines = secret_doc["lines"]
    assert isinstance(lines, list)
    string_data = extract_map(lines, "stringData")
    data = extract_map(lines, "data")
    decoded_data = decode_data_map(data)
    merged = {}
    for key in set(string_data.keys()) | set(decoded_data.keys()):
        if key in string_data:
            merged[key] = string_data[key]
        else:
            merged[key] = decoded_data.get(key, "")
    return merged


values = {key: "" for key in ORDER}

namespace_doc = find_doc(kind="Namespace")
if namespace_doc is not None:
    values["NAMESPACE"] = str(namespace_doc["name"] or "")

if not values["NAMESPACE"]:
    for doc in docs:
        lines = doc["lines"]
        assert isinstance(lines, list)
        namespace_value = extract_metadata_field(lines, "namespace")
        if namespace_value:
            values["NAMESPACE"] = namespace_value
            break

runtime_config_doc = find_doc(kind="ConfigMap", name="sortsys-runtime")
if runtime_config_doc is not None:
    runtime_lines = runtime_config_doc["lines"]
    assert isinstance(runtime_lines, list)
    runtime_data = extract_map(runtime_lines, "data")
    values["API_PORT"] = runtime_data.get("API_PORT", values["API_PORT"])
    values["NODE_ENV"] = runtime_data.get("NODE_ENV", values["NODE_ENV"])
    values["OBJECT_STORAGE_PROXY_URL"] = runtime_data.get("OBJECT_STORAGE_PROXY_URL", values["OBJECT_STORAGE_PROXY_URL"])
    values["JOB_RUNNER_WS_URL"] = runtime_data.get("JOB_RUNNER_WS_URL", values["JOB_RUNNER_WS_URL"])
    values["NO_PROXY"] = runtime_data.get("NO_PROXY", values["NO_PROXY"])

app_secret_doc = find_doc(kind="Secret", name="sortsys-app-secrets")
if app_secret_doc is not None:
    app_secret = secret_values(app_secret_doc)
    values["JWT_SECRET"] = app_secret.get("JWT_SECRET", values["JWT_SECRET"])
    values["ADMIN_HASH"] = app_secret.get("ADMIN_HASH", values["ADMIN_HASH"])
    values["JOB_RUNNER_TOKEN"] = app_secret.get("JOB_RUNNER_TOKEN", values["JOB_RUNNER_TOKEN"])
    values["POSTGRES_DB"] = app_secret.get("POSTGRES_DB", values["POSTGRES_DB"])
    values["POSTGRES_USER"] = app_secret.get("POSTGRES_USER", values["POSTGRES_USER"])
    values["POSTGRES_PASSWORD"] = app_secret.get("POSTGRES_PASSWORD", values["POSTGRES_PASSWORD"])

docker_secret_doc = find_doc(kind="Secret", type_value="kubernetes.io/dockerconfigjson")
if docker_secret_doc is not None:
    values["IMAGE_PULL_SECRET_NAME"] = str(docker_secret_doc["name"] or "")
    pull_secret_values = secret_values(docker_secret_doc)
    docker_config_raw = pull_secret_values.get(".dockerconfigjson", "")
    if docker_config_raw:
        try:
            docker_config = json.loads(docker_config_raw)
        except Exception as exc:
            fail(f"invalid .dockerconfigjson in pull secret: {exc}")

        auths = docker_config.get("auths") or {}
        if isinstance(auths, dict) and auths:
            registry_server, auth_entry = next(iter(auths.items()))
            values["REGISTRY_SERVER"] = str(registry_server).rstrip("/")
            if isinstance(auth_entry, dict):
                username = str(auth_entry.get("username") or "").strip()
                password = str(auth_entry.get("password") or "")
                if (not username or not password) and auth_entry.get("auth"):
                    decoded_auth = decode_base64(str(auth_entry.get("auth")))
                    if ":" in decoded_auth:
                        maybe_username, maybe_password = decoded_auth.split(":", 1)
                        if not username:
                            username = maybe_username.strip()
                        if not password:
                            password = maybe_password
                values["REGISTRY_USERNAME"] = username
                values["REGISTRY_PASSWORD"] = password

if not values["IMAGE_PULL_SECRET_NAME"]:
    service_account_doc = find_doc(kind="ServiceAccount", name="sortsys-workload")
    if service_account_doc is not None:
        service_account_lines = service_account_doc["lines"]
        assert isinstance(service_account_lines, list)
        values["IMAGE_PULL_SECRET_NAME"] = extract_first_pull_secret_name(service_account_lines)

api_deployment_doc = find_doc(kind="Deployment", name="sortsys-api")
if api_deployment_doc is not None:
    api_lines = api_deployment_doc["lines"]
    assert isinstance(api_lines, list)
    values["API_REPLICAS"] = extract_first_key(api_lines, "replicas")
    values["API_IMAGE"] = extract_first_key(api_lines, "image")

webapp_deployment_doc = find_doc(kind="Deployment", name="sortsys-webapp")
if webapp_deployment_doc is not None:
    webapp_lines = webapp_deployment_doc["lines"]
    assert isinstance(webapp_lines, list)
    values["WEBAPP_REPLICAS"] = extract_first_key(webapp_lines, "replicas")
    values["WEBAPP_IMAGE"] = extract_first_key(webapp_lines, "image")

jobrunner_deployment_doc = find_doc(kind="Deployment", name="sortsys-jobrunner")
if jobrunner_deployment_doc is not None:
    jobrunner_lines = jobrunner_deployment_doc["lines"]
    assert isinstance(jobrunner_lines, list)
    values["JOBRUNNER_REPLICAS"] = extract_first_key(jobrunner_lines, "replicas")
    values["JOBRUNNER_IMAGE"] = extract_first_key(jobrunner_lines, "image")

postgres_statefulset_doc = find_doc(kind="StatefulSet", name="sortsys-postgres")
if postgres_statefulset_doc is not None:
    postgres_lines = postgres_statefulset_doc["lines"]
    assert isinstance(postgres_lines, list)
    values["POSTGRES_IMAGE"] = extract_first_key(postgres_lines, "image")
    values["POSTGRES_SERVICE_NAME"] = extract_first_key(postgres_lines, "serviceName")
    values["POSTGRES_STORAGE_SIZE"] = extract_first_key(postgres_lines, "storage")
    values["POSTGRES_STORAGE_CLASS"] = extract_first_key(postgres_lines, "storageClassName")

api_service_doc = find_doc(kind="Service", name="sortsys-api")
if api_service_doc is not None:
    api_service_lines = api_service_doc["lines"]
    assert isinstance(api_service_lines, list)
    values["API_NODE_PORT"] = extract_first_key(api_service_lines, "nodePort")
    if not values["API_PORT"]:
        values["API_PORT"] = extract_first_key(api_service_lines, "port")

webapp_service_doc = find_doc(kind="Service", name="sortsys-webapp")
if webapp_service_doc is not None:
    webapp_service_lines = webapp_service_doc["lines"]
    assert isinstance(webapp_service_lines, list)
    values["WEBAPP_NODE_PORT"] = extract_first_key(webapp_service_lines, "nodePort")

for key, value in values.items():
    if "\n" in value or "\r" in value:
        fail(f"{key} contains a newline and cannot be written as KEY=VALUE")

missing_required = [key for key in ORDER if key not in OPTIONAL_KEYS and not values.get(key, "")]
if missing_required:
    joined = ", ".join(missing_required)
    fail(
        "failed to extract required keys from manifest: "
        + joined
        + ". Expected a file generated by ./scripts/create-kubernetes-config."
    )

for key in ORDER:
    print(f"{key}={values.get(key, '')}")
PY

mv "$TMP_OUTPUT" "$OUTPUT_FILE"
trap - EXIT

echo "Created $OUTPUT_FILE from $INPUT_FILE"
echo "Use it with: ./scripts/create-kubernetes-config --env-file $OUTPUT_FILE"
