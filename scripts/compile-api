#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
cp -R /input/. /sortsys-api-v2/
cd /sortsys-api-v2

case "$mode" in
  candidate)
    cargo fmt --all --check
    cargo clippy --release --workspace --all-targets --locked -- -D warnings
    cargo build --release --workspace --bins --locked
    cargo test --release --workspace --locked --no-run --message-format=json \
      >/ci-output/cargo-tests.jsonl
    cargo test --release --workspace --locked --doc
    ./target/release/generate_contract --check
    ;;
  deploy)
    cargo build --release --locked --package sortsys-api --bin seed_dev
    install -m 0755 ./target/release/seed_dev /ci-output/seed_dev
    ;;
  *)
    echo "Usage: compile-api candidate|deploy" >&2
    exit 1
    ;;
esac
