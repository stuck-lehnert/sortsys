#!/usr/bin/env bash
set -euo pipefail

AWS_CLI_IMAGE="${AWS_CLI_IMAGE:-docker.io/amazon/aws-cli:latest}"
CONTAINER_ENGINE="${CONTAINER_ENGINE:-}"

CORS_RULE_ID="${CORS_RULE_ID:-sortsys-webapp-cors}"
CORS_MAX_AGE_SECONDS="${CORS_MAX_AGE_SECONDS:-3000}"

DEFAULT_S3_ENDPOINT="${DEFAULT_S3_ENDPOINT:-https://fsn1.your-objectstorage.com}"
DEFAULT_S3_REGION="${DEFAULT_S3_REGION:-fsn1}"
DEFAULT_CORS_DOMAIN="${DEFAULT_CORS_DOMAIN:-app.sortsys.de}"

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

resolve_container_engine() {
  if [ -n "$CONTAINER_ENGINE" ]; then
    command -v "$CONTAINER_ENGINE" >/dev/null 2>&1 || fail "container engine not found: $CONTAINER_ENGINE"
    return
  fi

  if command -v podman >/dev/null 2>&1; then
    CONTAINER_ENGINE="podman"
    return
  fi

  if command -v docker >/dev/null 2>&1; then
    CONTAINER_ENGINE="docker"
    return
  fi

  fail "neither podman nor docker was found"
}

prompt_visible() {
  local label="$1"
  local default_value="${2:-}"
  local allow_empty="${3:-0}"
  local value=""

  while :; do
    if { exec 3</dev/tty 4>/dev/tty; } 2>/dev/null; then
      if [ -n "$default_value" ]; then
        printf '%s [%s]: ' "$label" "$default_value" >&4
      else
        printf '%s: ' "$label" >&4
      fi

      if ! IFS= read -r -u 3 value; then
        exec 3<&- 4>&-
        fail "could not read interactive input"
      fi

      exec 3<&- 4>&-
    elif [ -t 0 ]; then
      if [ -n "$default_value" ]; then
        read -r -p "$label [$default_value]: " value
      else
        read -r -p "$label: " value
      fi
    else
      fail "no interactive terminal is available"
    fi

    if [ -z "$value" ] && [ -n "$default_value" ]; then
      value="$default_value"
    fi

    if [ "$allow_empty" -eq 1 ] || [ -n "$value" ]; then
      printf '%s' "$value"
      return
    fi

    echo "Value must not be empty." >&2
  done
}

prompt_hidden() {
  local label="$1"
  local allow_empty="${2:-0}"
  local value=""

  while :; do
    if { exec 3</dev/tty 4>/dev/tty; } 2>/dev/null; then
      printf '%s: ' "$label" >&4

      if ! IFS= read -r -s -u 3 value; then
        printf '\n' >&4
        exec 3<&- 4>&-
        fail "could not read interactive secret input"
      fi

      printf '\n' >&4
      exec 3<&- 4>&-
    elif [ -t 0 ]; then
      printf '%s: ' "$label" >&2
      if ! IFS= read -r -s value; then
        printf '\n' >&2
        fail "could not read interactive secret input"
      fi
      printf '\n' >&2
    else
      fail "no interactive terminal is available"
    fi

    if [ "$allow_empty" -eq 1 ] || [ -n "$value" ]; then
      printf '%s' "$value"
      return
    fi

    echo "Value must not be empty." >&2
  done
}

prompt_yes_no() {
  local label="$1"
  local default_answer="${2:-n}"
  local raw

  raw="$(prompt_visible "$label" "$default_answer")"
  raw="${raw,,}"

  case "$raw" in
    y|yes) return 0 ;;
    n|no) return 1 ;;
    *)
      echo "Please answer yes or no." >&2
      prompt_yes_no "$label" "$default_answer"
      return $?
      ;;
  esac
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

normalize_origin() {
  local raw="$1"
  local origin

  origin="$(trim "$raw")"
  [ -n "$origin" ] || fail "domain/origin must not be empty"

  if [[ "$origin" != http://* && "$origin" != https://* ]]; then
    origin="https://$origin"
  fi

  origin="${origin%/}"

  if [[ ! "$origin" =~ ^https?://[^/]+$ ]]; then
    fail "invalid origin '$origin' (expected http(s)://host[:port] without path)"
  fi

  printf '%s' "$origin"
}

apply_bucket_cors() {
  local s3_endpoint="$1"
  local s3_region="$2"
  local s3_bucket="$3"
  local s3_access_key_id="$4"
  local s3_secret_access_key="$5"
  local s3_session_token="$6"
  local s3_origin="$7"
  local s3_addressing_style="$8"

  umask 077
  local envfile
  envfile="$(mktemp)"

  cat >"$envfile" <<EOF
AWS_ACCESS_KEY_ID=$s3_access_key_id
AWS_SECRET_ACCESS_KEY=$s3_secret_access_key
AWS_DEFAULT_REGION=$s3_region
AWS_REGION=$s3_region
AWS_EC2_METADATA_DISABLED=true
S3_ENDPOINT=$s3_endpoint
S3_BUCKET=$s3_bucket
S3_ORIGIN=$s3_origin
S3_ADDRESSING_STYLE=$s3_addressing_style
CORS_RULE_ID=$CORS_RULE_ID
CORS_MAX_AGE_SECONDS=$CORS_MAX_AGE_SECONDS
EOF

  if [ -n "$s3_session_token" ]; then
    printf 'AWS_SESSION_TOKEN=%s\n' "$s3_session_token" >>"$envfile"
  fi

  local status=0

  if "$CONTAINER_ENGINE" run --rm -i \
    --env-file "$envfile" \
    --entrypoint /bin/sh \
    "$AWS_CLI_IMAGE" -s <<'EOSH'
set -euo pipefail

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

current_cors="$tmpdir/current-cors.json"
next_cors="$tmpdir/next-cors.json"

run_aws_s3api() {
  op="$1"
  shift

  S3API_LAST_ERROR_CODE=""
  S3API_LAST_ERROR_MESSAGE=""

  err_file="$tmpdir/aws-${op}.err"
  decoded_error=0

  if aws s3api "$op" "$@" 2>"$err_file"; then
    rm -f "$err_file"
    return 0
  fi

  if grep -q "argument of type 'NoneType' is not" "$err_file"; then
    debug_file="$tmpdir/aws-${op}.debug"
    aws s3api "$op" "$@" --debug >/dev/null 2>"$debug_file" || true

    code="$(grep -o '<Code>[^<]*</Code>' "$debug_file" | tail -n1 | sed 's#<Code>##; s#</Code>##' || true)"
    message="$(grep -o '<Message>[^<]*</Message>' "$debug_file" | tail -n1 | sed 's#<Message>##; s#</Message>##' || true)"

    S3API_LAST_ERROR_CODE="$code"
    S3API_LAST_ERROR_MESSAGE="$message"

    if [ -n "$code" ] || [ -n "$message" ]; then
      decoded_error=1

      if [ "$op" = "get-bucket-cors" ] && [ "$code" = "NoSuchCORSConfiguration" ]; then
        return 2
      fi

      echo "S3 API request failed for '$op':" >&2
      echo "  Code: ${code:-unknown}" >&2
      echo "  Message: ${message:-<empty>}" >&2
      echo "  Hint: verify endpoint, region, bucket name and credentials." >&2
    fi
  fi

  if [ "$decoded_error" -eq 1 ]; then
    return 1
  fi

  cat "$err_file" >&2
  return 1
}

if [ "${S3_ADDRESSING_STYLE:-}" = "path" ] || [ "${S3_ADDRESSING_STYLE:-}" = "virtual" ]; then
  aws configure set default.s3.addressing_style "$S3_ADDRESSING_STYLE" >/dev/null
fi

if run_aws_s3api get-bucket-cors \
  --bucket "$S3_BUCKET" \
  --endpoint-url "$S3_ENDPOINT" \
  --region "$AWS_DEFAULT_REGION" \
  --output json >"$current_cors"; then
  :
else
  get_bucket_cors_status=$?

  if [ "$get_bucket_cors_status" -eq 2 ] || [ "$S3API_LAST_ERROR_CODE" = "NoSuchCORSConfiguration" ] || grep -q 'NoSuchCORSConfiguration' "$tmpdir/aws-get-bucket-cors.err"; then
    printf '{"CORSRules": []}\n' >"$current_cors"
  else
    exit 1
  fi
fi

python3 - "$current_cors" "$next_cors" <<'PY'
import json
import os
import sys

source_path, target_path = sys.argv[1], sys.argv[2]

rule_id = os.environ.get("CORS_RULE_ID", "sortsys-webapp-cors")
origin = os.environ["S3_ORIGIN"].strip()
max_age = int(os.environ.get("CORS_MAX_AGE_SECONDS", "3000"))

required_methods = ["GET", "PUT", "HEAD"]
required_allowed_headers = ["*"]
required_expose_headers = [
    "ETag",
    "Content-Length",
    "Content-Type",
    "Content-Disposition",
    "x-amz-request-id",
    "x-amz-id-2",
]

with open(source_path, "r", encoding="utf-8") as f:
    try:
        current = json.load(f)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid JSON from get-bucket-cors: {exc}")

if not isinstance(current, dict):
    current = {}

rules = current.get("CORSRules")
if not isinstance(rules, list):
    rules = []


def unique_values(values):
    result = []
    for raw in values:
        if not isinstance(raw, str):
            continue
        value = raw.strip()
        if not value:
            continue
        if value not in result:
            result.append(value)
    return result


target_rule = None
for rule in rules:
    if isinstance(rule, dict) and rule.get("ID") == rule_id:
        target_rule = rule
        break

if target_rule is None:
    target_rule = {
        "ID": rule_id,
        "AllowedMethods": [],
        "AllowedOrigins": [],
        "AllowedHeaders": [],
        "ExposeHeaders": [],
        "MaxAgeSeconds": max_age,
    }
    rules.append(target_rule)

target_rule["AllowedMethods"] = unique_values(list(target_rule.get("AllowedMethods", [])) + required_methods)
target_rule["AllowedOrigins"] = unique_values(list(target_rule.get("AllowedOrigins", [])) + [origin])
target_rule["AllowedHeaders"] = unique_values(list(target_rule.get("AllowedHeaders", [])) + required_allowed_headers)
target_rule["ExposeHeaders"] = unique_values(list(target_rule.get("ExposeHeaders", [])) + required_expose_headers)

existing_max_age = target_rule.get("MaxAgeSeconds")
if isinstance(existing_max_age, int):
    target_rule["MaxAgeSeconds"] = max(existing_max_age, max_age)
else:
    target_rule["MaxAgeSeconds"] = max_age

current["CORSRules"] = rules

with open(target_path, "w", encoding="utf-8") as f:
    json.dump(current, f, indent=2)
    f.write("\n")
PY

run_aws_s3api put-bucket-cors \
  --bucket "$S3_BUCKET" \
  --endpoint-url "$S3_ENDPOINT" \
  --region "$AWS_DEFAULT_REGION" \
  --cors-configuration "file://$next_cors" >/dev/null

echo
echo "Updated S3 bucket CORS successfully."
echo "Bucket: $S3_BUCKET"
echo "Origin added: $S3_ORIGIN"
echo "Rule ID: $CORS_RULE_ID"
EOSH
  then
    status=0
  else
    status=$?
  fi

  rm -f "$envfile"
  return "$status"
}

main() {
  resolve_container_engine

  echo "Configure S3 bucket CORS for sortsys web uploads/downloads"
  echo

  local s3_endpoint
  local s3_region
  local s3_bucket
  local s3_access_key_id
  local s3_secret_access_key
  local s3_session_token
  local domain_or_origin
  local s3_origin
  local s3_addressing_style="virtual"

  s3_endpoint="$(prompt_visible "S3 endpoint URL" "$DEFAULT_S3_ENDPOINT")"
  s3_region="$(prompt_visible "S3 region" "$DEFAULT_S3_REGION")"
  s3_bucket="$(prompt_visible "S3 bucket name")"

  s3_access_key_id="$(prompt_hidden "S3 access key ID")"
  s3_secret_access_key="$(prompt_hidden "S3 secret access key")"
  s3_session_token="$(prompt_hidden "S3 session token (optional, press Enter to skip)" 1)"

  domain_or_origin="$(prompt_visible "Domain to allow (example: app.sortsys.de or https://app.sortsys.de)" "$DEFAULT_CORS_DOMAIN")"
  s3_origin="$(normalize_origin "$domain_or_origin")"

  if prompt_yes_no "Use path-style addressing (needed for many MinIO setups)? (yes/no)" "no"; then
    s3_addressing_style="path"
  fi

  echo
  echo "Will apply CORS with:"
  echo "- Container engine: $CONTAINER_ENGINE"
  echo "- AWS CLI image: $AWS_CLI_IMAGE"
  echo "- Endpoint: $s3_endpoint"
  echo "- Region: $s3_region"
  echo "- Bucket: $s3_bucket"
  echo "- Addressing style: $s3_addressing_style"
  echo "- Origin: $s3_origin"
  echo "- Required methods: GET, PUT, HEAD"
  echo

  if ! prompt_yes_no "Apply these changes now? (yes/no)" "yes"; then
    echo "Cancelled."
    exit 0
  fi

  apply_bucket_cors \
    "$s3_endpoint" \
    "$s3_region" \
    "$s3_bucket" \
    "$s3_access_key_id" \
    "$s3_secret_access_key" \
    "$s3_session_token" \
    "$s3_origin" \
    "$s3_addressing_style"
}

main "$@"
