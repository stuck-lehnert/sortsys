# Community MinIO no longer publishes container images. Build official, pinned
# source releases for the disposable development and integration-test services.
# https://github.com/minio/minio/releases/tag/RELEASE.2025-10-15T17-29-55Z
ARG GO_IMAGE=docker.io/library/golang:1.25-bookworm
FROM ${GO_IMAGE} AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
RUN go install -trimpath -ldflags="-s -w" github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z
RUN go install -trimpath -ldflags="-s -w" github.com/minio/mc@RELEASE.2025-08-13T08-35-41Z

FROM docker.io/library/debian:bookworm-slim
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /go/bin/minio /go/bin/mc /usr/local/bin/
EXPOSE 9000
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--address", ":9000"]
