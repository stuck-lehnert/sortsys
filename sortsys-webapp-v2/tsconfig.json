{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@sortsys/dwgviewer": ["../sortsys-dwgviewer/src/index.ts"],
      "@sortsys/dwgviewer/styles.css": ["../sortsys-dwgviewer/src/styles.css"],
      "@sortsys/business-logic": ["../sortsys-business-logic/src/index.ts"],
      "@sortsys/business-logic/pdf": [
        "../sortsys-business-logic/src/pdf/index.ts"
      ],
      "@sortsys/business-logic/*": ["../sortsys-business-logic/src/*.ts"],
      "@sortsys/v2-client/contract": [
        "../sortsys-api-v2/client/dist/generated/contract.d.ts"
      ]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
