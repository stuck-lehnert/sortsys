{
  "name": "sortsys-webapp-v2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint:client-casts": "node ../sortsys-api-v2/client/scripts/check-no-client-method-any-casts.mjs",
    "lint:box-shadows": "node ./scripts/check-no-box-shadows.mjs",
    "licenses:generate": "node ../scripts/generate-license-inventory.mjs",
    "licenses:check": "node ../scripts/generate-license-inventory.mjs --check",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "bun run lint:client-casts && bun run lint:box-shadows && bun run lint:i18n && bun run lint:llm-naming && node ./scripts/check-v2-client-types.mjs && react-router typegen && tsc -p tsconfig.typecheck.json",
    "lint:i18n": "node ./scripts/check-i18n.mjs",
    "test:security-deps": "node --test scripts/securityDependencies.test.mjs scripts/securityAdvisories.test.mjs scripts/securityGlobDependencies.test.mjs",
    "test:visit-labels": "bun test app/lib/visitLabels.test.mjs",
    "test:activity": "bun test app/lib/activity*.test.mjs app/components/ActivityReference.test.mjs",
    "test:report-forms": "bun test app/lib/reportForm.test.mjs",
    "test:chat-requests": "bun test app/lib/chatRequests.test.mjs app/lib/llmProposalInput.test.mjs",
    "test:chat-files": "bun test app/lib/chatFiles.test.mjs",
    "test:deployment-planning": "bun test app/lib/deploymentPlanning.test.mjs",
    "test:table": "bun test app/components/MyTable.test.mjs",
    "test:menus": "bun test app/components/Menu.test.mjs",
    "test:ui": "bun scripts/ui/build-fixtures.mjs && node --test --test-concurrency=1 scripts/ui/*.browser.mjs",
    "test:editors": "bun test app/lib/editorStartup.test.mjs",
    "test:i18n": "bun test app/lib/i18n.test.mjs app/lib/loginError.test.mjs app/components/MyCallout.test.mjs",
    "test:pdf": "bun test app/lib/pdfLayout.test.mjs",
    "test:invoice-numbering": "bun test app/lib/invoiceNumbering.test.mjs",
    "test:offer-numbering": "node --experimental-strip-types --test app/lib/offerNumbering.test.mjs",
    "test:regie-list": "bun test app/lib/regieReportList.test.mjs",
    "preview:pdf": "bun scripts/preview-pdfs.mjs",
    "test:error-boundary": "node --test scripts/errorBoundary.test.mjs",
    "test:attachment-selection": "node --test scripts/attachmentSelection.test.mjs",
    "test:attachments": "bun test app/lib/attachmentPreviews.test.mjs app/lib/pdfViewer.test.mjs scripts/pdfjsViewerPlugin.test.mjs",
    "lint:llm-naming": "node ./scripts/check-llm-naming.mjs",
    "test:local-package-locks": "node --test scripts/localPackageLocks.test.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.91.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@kenjiuno/msgreader": "1.29.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@sortsys/dwgviewer": "file:../sortsys-dwgviewer",
    "@sortsys/gaeb": "file:../sortsys-gaeb",
    "@sortsys/react-components": "file:../sortsys-react-components",
    "@sortsys/v2-client": "file:../sortsys-api-v2/client",
    "exceljs": "^4.4.0",
    "isbot": "^5.2.2",
    "jszip": "^3.10.2",
    "monaco-editor": "^0.57.0",
    "parse5": "8.1.1",
    "pdfjs-dist": "6.5.438",
    "postal-mime": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "compression": "1.8.2",
    "dompurify": "3.4.17",
    "qs": "6.16.1",
    "uuid": "11.1.1",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "serialize-javascript": "7.1.3",
    "minimatch": "11.0.2",
    "glob": "14.0.3",
    "unzipper": "0.12.5"
  }
}
