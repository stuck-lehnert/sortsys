{
  "name": "sortsys-webapp-v2",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint:client-casts": "node ../sortsys-api-v2/client/scripts/check-no-client-method-any-casts.mjs",
    "lint:box-shadows": "node ./scripts/check-no-box-shadows.mjs",
    "licenses:generate": "node ../scripts/generate-license-inventory.mjs",
    "licenses:check": "node ../scripts/generate-license-inventory.mjs --check",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "bun run lint:client-casts && bun run lint:box-shadows && bun run lint:i18n && bun run lint:llm-naming && node ./scripts/check-v2-client-types.mjs && react-router typegen && tsc",
    "lint:i18n": "node ./scripts/check-i18n.mjs",
    "test:security-deps": "node --test scripts/securityDependencies.test.mjs",
    "test:i18n": "bun test app/lib/i18n.test.mjs app/components/MyCallout.test.mjs",
    "test:pdf": "bun test app/lib/pdfLayout.test.mjs",
    "test:regie-list": "bun test app/lib/regieReportList.test.mjs",
    "preview:pdf": "bun scripts/preview-pdfs.mjs",
    "test:attachments": "bun test app/lib/attachmentPreviews.test.mjs app/lib/pdfViewer.test.mjs scripts/pdfjsViewerPlugin.test.mjs",
    "lint:llm-naming": "node ./scripts/check-llm-naming.mjs"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "1.28.0",
    "@carbon/icons-react": "^11.89.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@sortsys/dwgviewer": "file:../sortsys-dwgviewer",
    "@sortsys/react-components": "file:../sortsys-react-components",
    "@sortsys/v2-client": "file:../sortsys-api-v2/client",
    "exceljs": "^4.4.0",
    "isbot": "^5.2.2",
    "jszip": "^3.10.2",
    "monaco-editor": "^0.57.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "postal-mime": "4.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@types/node": "^24",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "compression": "1.8.2",
    "dompurify": "3.4.16",
    "qs": "6.16.0",
    "uuid": "11.1.1"
  }
}
