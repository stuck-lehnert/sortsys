    "lint:i18n": "node ./scripts/check-i18n.mjs",
    "test:i18n": "bun test app/lib/i18n.test.mjs app/components/MyCallout.test.mjs",
    "lint:llm-naming": "node ./scripts/check-llm-naming.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.71.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/ubuntu": "^5.3.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@react-router/node": "7.18.3",
    "@react-router/serve": "7.18.3",
    "@sortsys/dwgviewer": "file:../sortsys-dwgviewer",
    "@sortsys/react-components": "file:../sortsys-react-components",
    "@sortsys/v2-client": "file:../sortsys-api-v2/client/dist",
    "exceljs": "^4.4.0",
    "isbot": "^5.1.31",
