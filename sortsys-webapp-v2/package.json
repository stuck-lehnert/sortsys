    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.3",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
