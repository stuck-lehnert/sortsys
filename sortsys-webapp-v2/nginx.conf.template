resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;
resolver_timeout 2s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}

map $http_x_forwarded_host $forwarded_host {
  default $http_x_forwarded_host;
  '' $http_host;
}

server {
  listen 80 default_server;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size ${CLIENT_MAX_BODY_SIZE};

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  location /api/v2/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Prefix /api/v2;
    proxy_set_header X-Forwarded-Host $forwarded_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
    absolute_redirect off;

  # The private Office editor has separate origins and never uses this proxy.
  location ~ ^/office(?:/|$) {
    return 403;
  }

  location = /drawio {
    return 308 /drawio/;
  }

  # diagrams.net supplies static editor assets. Never forward document data to
  # its export/proxy/import or cloud integration servlets.
  location ~ ^/drawio/(?:proxy|export|i|service|log|github2|gitlab|google|microsoft|dropbox)(?:/|$) {
    return 403;
  }

  location /drawio/ {
    limit_except GET HEAD {
      deny all;
    }
    # The official image serves its web application at /drawio. Preserve that
    # path instead of stripping it while proxying.
    set $drawio_upstream ${DRAWIO_UPSTREAM};
    proxy_pass $drawio_upstream$request_uri;
    proxy_connect_timeout 2s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $forwarded_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; form-action 'none'; base-uri 'self'" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location /pdfjs/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff";

    location ~ \.mjs$ {
      try_files $uri =404;
      default_type application/javascript;
    }
  }

  location /assets/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location ~ ^/(?:sw\.js|registerSW\.js|manifest\.webmanifest)$ {
    try_files $uri =404;
    expires -1;
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  location = /index.html {
    expires -1;
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
