ARG RUST_IMAGE=docker.io/library/rust:1.99-bookworm

FROM docker.io/oven/bun:1.4.4 AS bun
FROM docker.io/library/node:24 AS node

FROM ${RUST_IMAGE} AS duckdb
COPY rust-api/duckdb/install /tmp/install-duckdb
RUN bash /tmp/install-duckdb /opt/duckdb

FROM ${RUST_IMAGE}
RUN rustup component add rustfmt clippy \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /workspace /test-cache/target /tmp/test-logs
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=duckdb /opt/duckdb /opt/duckdb
COPY rust-api/duckdb/licenses /usr/local/share/licenses/sortsys-duckdb
ENV DUCKDB_LIB_DIR=/opt/duckdb DUCKDB_INCLUDE_DIR=/opt/duckdb DUCKDB_EXTENSION_DIRECTORY=/opt/duckdb/extensions
RUN ln -s /opt/duckdb/libduckdb.so /usr/local/lib/libduckdb.so && ldconfig
ENV CARGO_TARGET_DIR=/test-cache/target SORTSYS_NATIVE_LOG_DIRECTORY=/tmp/test-logs
WORKDIR /workspace
